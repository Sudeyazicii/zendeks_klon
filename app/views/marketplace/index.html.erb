<% content_for :title, "PulseDesk AI Agent Marketplace" %>

<!-- 1. ÜST HERO BANNER: BAYRAM YOĞUNLUK KALKANI -->
<div class="card" style="margin-bottom: 1.5rem; padding: 2rem; background: linear-gradient(135deg, #1e1b4b 0%, #312e81 45%, #4338ca 100%); color: white; border: none; box-shadow: 0 20px 25px -5px rgba(30, 27, 75, 0.25); border-radius: var(--radius-lg); position: relative; overflow: hidden;">
  <!-- Arka plan parlama efekti -->
  <div style="position: absolute; right: -50px; top: -50px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(129, 140, 248, 0.25) 0%, rgba(30, 27, 75, 0) 70%); border-radius: 50%; pointer-events: none;"></div>

  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; position: relative; z-index: 1;">
    <div style="max-width: 680px;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px); padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.825rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.85rem; border: 1px solid rgba(255, 255, 255, 0.2);">
        <span>🌙 ÖZEL NÖBETÇİ PAKETİ</span> • <span>7/24 KESİNTİSİZ DESTEK</span>
      </div>
      <h1 style="font-size: 2.15rem; font-weight: 900; line-height: 1.2; margin-bottom: 0.65rem; color: #ffffff; letter-spacing: -0.025em;">
        Bayramda 5 Uzman Destek Ajanı Kirala
      </h1>
      <p style="font-size: 1rem; color: #e0e7ff; line-height: 1.55; margin-bottom: 1.25rem;">
        Resmi tatil ve bayramlarda insan destek ekibiniz izindeyken biletler yığılmasın, SLA taahhütleriniz patlamasın. 
        Kargo iadesi, e-Fatura mevzuatı, 502 Bad Gateway krizleri ve öfkeli müşteriler için <strong>5 uzman yapay zeka ajanını tek tıkla 7 günlüğüne işe alın.</strong>
      </p>

      <div style="display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
        <% if @bayram_pack_active %>
          <div style="background: rgba(16, 185, 129, 0.2); border: 1px solid #34d399; color: #a7f3d0; padding: 0.65rem 1.15rem; border-radius: 8px; font-weight: 700; display: inline-flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 1.2rem;">✅</span> 5 Ajan Aktif Nöbette (Bayram Kalkanı Devrede)
          </div>

          <%= form_with url: simulate_surge_marketplace_path, method: :post, local: true, style: "display: inline;" do %>
            <%= hidden_field_tag :count, 10 %>
            <button type="submit" class="btn btn-primary" style="background: #f59e0b; border-color: #d97706; color: #78350f; font-weight: 800; padding: 0.7rem 1.35rem; box-shadow: 0 4px 14px 0 rgba(245, 158, 11, 0.39);">
              ⚡ 10 Biletlik Bayram Fırtınası Simülasyonu Başlat
            </button>
          <% end %>
        <% else %>
          <%= form_with url: hire_bayram_pack_marketplace_path, method: :post, local: true, style: "display: inline;" do %>
            <%= hidden_field_tag :duration_days, 7 %>
            <button type="submit" class="btn btn-primary" style="background: #38bdf8; border-color: #0284c7; color: #082f49; font-weight: 800; font-size: 0.95rem; padding: 0.75rem 1.6rem; border-radius: 8px; box-shadow: 0 4px 14px rgba(56, 189, 248, 0.4);">
              🚀 5 Ajanı 1 Tıkla Kirala (7 Gün — ₺1.400 / gün)
            </button>
          <% end %>

          <%= form_with url: simulate_surge_marketplace_path, method: :post, local: true, style: "display: inline;" do %>
            <%= hidden_field_tag :count, 10 %>
            <button type="submit" class="btn" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); color: white; font-weight: 700; padding: 0.75rem 1.15rem; border-radius: 8px;">
              ⚡ Canlı Bilet Dalgası Test Et
            </button>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Hızlı Bilgi & Karşılaştırma Kutusu -->
    <div style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: var(--radius-md); padding: 1.25rem; width: 310px;">
      <h3 style="font-size: 0.9rem; font-weight: 800; color: #f8fafc; margin-bottom: 0.65rem; display: flex; align-items: center; gap: 0.5rem;">
        📊 Slop Testi & Değer Teklifi
      </h3>
      <div style="font-size: 0.825rem; color: #c7d2fe; display: flex; flex-direction: column; gap: 0.55rem;">
        <div style="display: flex; justify-content: space-between;">
          <span>Geleneksel İnsan Mesaisi:</span>
          <strong style="color: #f87171;">₺37.800 / hafta</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span>5 AI Destek Ajanı:</span>
          <strong style="color: #4ade80;">₺9.800 / hafta</strong>
        </div>
        <div style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, 0.15); padding-top: 0.45rem;">
          <span>Tasarruf Oranı:</span>
          <strong style="color: #38bdf8;">%74 Maliyet Avantajı</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span>SLA İlk Yanıt Süresi:</span>
          <strong style="color: #facc15;">&lt; 30 Saniye</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span>Human-in-the-Loop:</span>
          <strong style="color: #ffffff;">Riskte İnsan Onayı</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 2. TELEMETRİ SAYAÇLARI -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin-bottom: 1.5rem;">
  <div class="stat-card" style="border-top: 4px solid #6366f1;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">🤖</div>
    <div class="stat-value" style="color: #4338ca;"><%= @total_rented_count %> / 5</div>
    <div class="stat-label">Aktif Kiralık Ajan</div>
  </div>

  <div class="stat-card" style="border-top: 4px solid #059669;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">⚡</div>
    <div class="stat-value" style="color: #059669;"><%= @total_tickets_solved %></div>
    <div class="stat-label">Otonom Çözülen Bilet</div>
  </div>

  <div class="stat-card" style="border-top: 4px solid #dc2626;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">🛡️</div>
    <div class="stat-value" style="color: #dc2626;"><%= @total_sla_saved %></div>
    <div class="stat-label">Kurtarılan SLA İhlali</div>
  </div>

  <div class="stat-card" style="border-top: 4px solid #d97706;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">💰</div>
    <div class="stat-value" style="color: #d97706;">₺<%= sprintf("%.0f", @total_cost_saved) %></div>
    <div class="stat-label">Tasarruf Edilen İnsan Mesaisi</div>
  </div>

  <div class="stat-card" style="border-top: 4px solid #7c3aed;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">👥</div>
    <div class="stat-value" style="color: #7c3aed;"><%= @pending_reviews.count %></div>
    <div class="stat-label">İnsan Onayı Bekleyen (HITL)</div>
  </div>
</div>

<!-- 3. ANA SEKMELER: PAZARYERİ vs KİRALANAN AJANLARIM vs ONAY KUYRUĞU vs CANLI LOGLAR -->
<div class="card" style="padding: 0.65rem 1rem; margin-bottom: 1.75rem; background: #ffffff;">
  <div class="filter-tabs" style="display: flex; flex-wrap: wrap; gap: 0.5rem; background: transparent; padding: 0;">
    <a href="<%= marketplace_path(tab: 'catalog') %>" class="filter-tab <%= 'active' if @tab == 'catalog' %>" style="font-weight: 700; font-size: 0.9rem; padding: 0.55rem 1.15rem;">
      🏪 Ajan Pazaryeri (Katalog & Kirala)
    </a>

    <a href="<%= marketplace_path(tab: 'my_agents') %>" class="filter-tab <%= 'active' if @tab == 'my_agents' %>" style="font-weight: 700; font-size: 0.9rem; padding: 0.55rem 1.15rem; color: #4338ca;">
      💼 Kiralanan Ajanlarım (<%= @total_rented_count %> Aktif Kadro)
    </a>

    <a href="<%= marketplace_path(tab: 'reviews') %>" class="filter-tab <%= 'active' if @tab == 'reviews' %>" style="font-weight: 700; font-size: 0.9rem; padding: 0.55rem 1.15rem; color: #d97706;">
      ⚠️ İnsan Onayı Bekleyenler (<%= @pending_reviews.count %>)
    </a>

    <a href="<%= marketplace_path(tab: 'logs') %>" class="filter-tab <%= 'active' if @tab == 'logs' %>" style="font-weight: 700; font-size: 0.9rem; padding: 0.55rem 1.15rem; color: #475569;">
      📡 Canlı CoT Akıl Yürütme Günlüğü
    </a>
  </div>
</div>

<!-- =================================================================================== -->
<!-- SEKME 1: AJAN PAZARYERİ (KATALOG / VİTRİN) -->
<!-- =================================================================================== -->
<% if @tab == "catalog" %>
  <div style="margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
        🏪 Destek Ajanları Pazaryeri (Vitrin)
      </h2>
      <p style="font-size: 0.85rem; color: var(--neutral-muted); margin: 0.2rem 0 0 0;">
        İhtiyacınıza uygun yapay zeka personelini seçin, uzmanlık alanını inceleyin ve anında 7 günlüğüne işe alın.
      </p>
    </div>

    <div>
      <a href="<%= marketplace_path(tab: 'my_agents') %>" class="btn btn-secondary btn-sm" style="font-weight: 700;">
        💼 Kiralanan Kadromu Gör (<%= @total_rented_count %>) →
      </a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    <% @agents.each do |agent| %>
      <% rental = agent.current_rental %>
      <% is_rented = rental&.active? %>

      <div class="card" style="border: 1px solid <%= is_rented ? agent.badge_color : 'var(--border)' %>; box-shadow: <%= is_rented ? '0 10px 15px -3px rgba(0, 0, 0, 0.1)' : 'var(--shadow-sm)' %>; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <!-- Başlık & Avatar Şeridi -->
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.85rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="font-size: 2.25rem; width: 56px; height: 56px; background: <%= agent.badge_color %>15; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid <%= agent.badge_color %>40;">
                <%= agent.avatar %>
              </div>
              <div>
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                  <h3 style="font-size: 1.15rem; font-weight: 800; margin: 0; color: var(--neutral-dark);">
                    <%= agent.name %>
                  </h3>
                  <span class="table-badge" style="background: <%= agent.badge_color %>20; color: <%= agent.badge_color %>; font-size: 0.7rem; font-weight: 700;">
                    <%= agent.category_focus %>
                  </span>
                </div>
                <div style="font-size: 0.8rem; font-weight: 600; color: var(--neutral-muted); margin-top: 0.15rem;">
                  <%= agent.role_title %>
                </div>
              </div>
            </div>

            <div>
              <% if is_rented %>
                <span class="table-badge badge-success" style="font-weight: 700; padding: 0.35rem 0.65rem;">
                  ● KİRALANDI (AKTİF)
                </span>
              <% else %>
                <span class="table-badge badge-secondary" style="font-weight: 600;">
                  MÜSAİT
                </span>
              <% end %>
            </div>
          </div>

          <!-- Açıklama / Bio -->
          <p style="font-size: 0.85rem; color: #475569; line-height: 1.55; margin-bottom: 0.85rem; min-height: 52px;">
            <%= agent.bio %>
          </p>

          <!-- Yetenek Etiketleri -->
          <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem;">
            <% agent.skills_list.each do |skill| %>
              <span class="table-badge" style="background: #f1f5f9; color: #334155; font-size: 0.7rem; font-weight: 600;">
                #<%= skill %>
              </span>
            <% end %>
          </div>

          <!-- Performans İstatistikleri -->
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.65rem 0.5rem; margin-bottom: 1.15rem; text-align: center;">
            <div>
              <div style="font-size: 0.7rem; color: var(--neutral-muted);">Doğruluk</div>
              <div style="font-size: 0.95rem; font-weight: 800; color: #059669;">%<%= agent.accuracy_rate %></div>
            </div>
            <div>
              <div style="font-size: 0.7rem; color: var(--neutral-muted);">Değerlendirme</div>
              <div style="font-size: 0.95rem; font-weight: 800; color: #d97706;">★ <%= agent.rating %></div>
            </div>
            <div>
              <div style="font-size: 0.7rem; color: var(--neutral-muted);">HITL Eşiği</div>
              <div style="font-size: 0.95rem; font-weight: 800; color: var(--primary);">%<%= agent.human_in_the_loop_threshold %></div>
            </div>
          </div>
        </div>

        <!-- Alt Aksiyon Şeridi & Kiralama Butonları -->
        <div style="border-top: 1px solid var(--border); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;">
          <div>
            <div style="font-size: 1.1rem; font-weight: 900; color: var(--neutral-dark);">
              ₺<%= sprintf("%.0f", agent.daily_rate) %> <span style="font-size: 0.75rem; font-weight: 500; color: var(--neutral-muted);">/ gün</span>
            </div>
            <div style="font-size: 0.75rem; color: var(--neutral-muted);">
              ₺<%= sprintf("%.0f", agent.hourly_rate) %> / saat
            </div>
          </div>

          <div>
            <% if is_rented %>
              <a href="<%= marketplace_path(tab: 'my_agents') %>" class="btn btn-secondary btn-sm" style="font-weight: 700; color: #059669;">
                ✓ Kadronuzda İncele →
              </a>
            <% else %>
              <%= form_with url: rent_agent_marketplace_path(agent), method: :post, local: true, style: "display: inline;" do %>
                <%= hidden_field_tag :duration_days, 7 %>
                <button type="submit" class="btn btn-primary btn-sm" style="background: <%= agent.badge_color %>; border-color: <%= agent.badge_color %>; font-weight: 700;">
                  🛒 Bu Ajanı Kirala (7 Gün)
                </button>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<!-- =================================================================================== -->
<!-- SEKME 2: KİRALANAN AJANLARIM (AKTİF DESTEK KADRONUZ) -->
<!-- =================================================================================== -->
<% if @tab == "my_agents" %>
  <div style="margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--neutral-dark); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <span>💼</span> Kiralanan Destek Ajanlarım (Aktif Kadro: <%= @total_rented_count %>)
      </h2>
      <p style="font-size: 0.85rem; color: var(--neutral-muted); margin: 0.2rem 0 0 0;">
        Pazaryerinden kiraladığınız ve şu anda gelen biletleri otonom karşılayan yapay zeka ekibiniz.
      </p>
    </div>

    <div style="display: flex; gap: 0.5rem;">
      <a href="<%= marketplace_path(tab: 'catalog') %>" class="btn btn-primary btn-sm">
        + Pazaryerinden Yeni Ajan Kirala
      </a>
      <%= form_with url: simulate_surge_marketplace_path, method: :post, local: true, style: "display: inline;" do %>
        <%= hidden_field_tag :count, 10 %>
        <button type="submit" class="btn btn-secondary btn-sm" style="font-weight: 700; color: #b45309;">
          ⚡ Kadroya Bayram Testi Gönder
        </button>
      <% end %>
    </div>
  </div>

  <% if @active_rentals.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
      <% @active_rentals.each do |rental| %>
        <% agent = rental.ai_agent %>
        <div class="card" style="border: 2px solid <%= agent.badge_color %>; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08); background: #ffffff;">
          <!-- Ajan Başlık & Kiralama Paketi -->
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.85rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="font-size: 2.25rem; width: 56px; height: 56px; background: <%= agent.badge_color %>15; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid <%= agent.badge_color %>40;">
                <%= agent.avatar %>
              </div>
              <div>
                <h3 style="font-size: 1.15rem; font-weight: 800; margin: 0; color: var(--neutral-dark);">
                  <%= agent.name %>
                </h3>
                <div style="font-size: 0.8rem; font-weight: 600; color: <%= agent.badge_color %>;">
                  <%= agent.role_title %>
                </div>
              </div>
            </div>

            <span class="table-badge badge-success" style="font-weight: 800; font-size: 0.75rem; padding: 0.35rem 0.65rem;">
              ● NÖBETTE
            </span>
          </div>

          <!-- Kiralama Sözleşme Rozeti -->
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.65rem 0.85rem; margin-bottom: 1rem; font-size: 0.8rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
              <span style="color: var(--neutral-muted);">Paket:</span>
              <strong style="color: var(--neutral-dark);"><%= rental.package_name %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
              <span style="color: var(--neutral-muted);">Kalan Süre:</span>
              <strong style="color: #059669;">⏳ <%= rental.remaining_days %> Gün (<%= rental.remaining_hours %> Saat)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--neutral-muted);">Bitiş Tarihi:</span>
              <span style="color: var(--neutral-dark);"><%= rental.expires_at.strftime("%d.%m.%Y %H:%M") %></span>
            </div>
          </div>

          <!-- Canlı Performans İstatistikleri -->
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius-sm); padding: 0.75rem 0.5rem; margin-bottom: 1.15rem; text-align: center;">
            <div>
              <div style="font-size: 0.7rem; color: #166534;">İşlenen Bilet</div>
              <div style="font-size: 1.1rem; font-weight: 900; color: #15803d;"><%= rental.tickets_processed_count %></div>
            </div>
            <div>
              <div style="font-size: 0.7rem; color: #166534;">Çözülen Bilet</div>
              <div style="font-size: 1.1rem; font-weight: 900; color: #15803d;"><%= rental.tickets_solved_count %></div>
            </div>
            <div>
              <div style="font-size: 0.7rem; color: #166534;">Kurtarılan SLA</div>
              <div style="font-size: 1.1rem; font-weight: 900; color: #dc2626;"><%= rental.sla_violations_prevented %></div>
            </div>
          </div>

          <!-- Tasarruf & Yönetim Aksiyonları -->
          <div style="border-top: 1px solid var(--border); padding-top: 0.85rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
            <div>
              <span style="font-size: 0.75rem; color: var(--neutral-muted);">Sağlanan Tasarruf:</span>
              <div style="font-size: 0.95rem; font-weight: 800; color: #d97706;">₺<%= sprintf("%.0f", rental.human_cost_saved) %></div>
            </div>

            <div style="display: flex; gap: 0.35rem;">
              <a href="<%= tickets_path(status: 'ai_handled') %>" class="btn btn-secondary btn-sm" style="font-size: 0.75rem;">
                Biletlerini Gör
              </a>
              <%= button_to "⏹️ Sonlandır", cancel_rental_marketplace_path(rental), method: :delete, data: { turbo_confirm: "#{agent.name} kiralama sözleşmesini iptal etmek ve kadrodan çıkarmak istediğinize emin misiniz?" }, class: "btn btn-sm", style: "background: #ef4444; color: white; font-size: 0.75rem;" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card" style="text-align: center; padding: 3.5rem; margin-bottom: 2rem;">
      <div style="font-size: 3rem; margin-bottom: 0.75rem;">🛒</div>
      <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--neutral-dark); margin-bottom: 0.35rem;">
        Henüz kiralanmış bir destek ajanınız bulunmuyor
      </h3>
      <p style="font-size: 0.9rem; color: var(--neutral-muted); max-width: 500px; margin: 0 auto 1.5rem auto;">
        Bayram tatili veya yoğun dönemlerde SLA sürelerinizi korumak için pazaryeri kataloğumuzdan tek tek ajan kiralayabilir ya da 5 ajanı tek tıkla işe alabilirsiniz.
      </p>
      <div style="display: flex; justify-content: center; gap: 0.75rem;">
        <a href="<%= marketplace_path(tab: 'catalog') %>" class="btn btn-primary">
          🏪 Ajan Kataloğuna Git ve Kirala
        </a>
      </div>
    </div>
  <% end %>
<% end %>

<!-- =================================================================================== -->
<!-- SEKME 3: HUMAN-IN-THE-LOOP ONAY KUYRUĞU -->
<!-- =================================================================================== -->
<% if @tab == "reviews" %>
  <div style="margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #92400e; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <span>⚠️</span> Human-in-the-Loop Onay Kuyruğu (<%= @pending_reviews.count %>)
      </h2>
      <p style="font-size: 0.85rem; color: var(--neutral-muted); margin: 0.2rem 0 0 0;">
        Ajanların yüksek tutarlı tazminat, hukuki risk veya güven eşiği altı nedeniyle otonom çözmeyip onayınıza sunduğu biletler.
      </p>
    </div>
  </div>

  <% if @pending_reviews.any? %>
    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem;">
      <% @pending_reviews.each do |log| %>
        <div class="card" style="border-left: 5px solid #d97706; background: #fffdf5;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.85rem;">
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                <span class="table-badge badge-warning">Güven Skoru: %<%= log.confidence_score %></span>
                <span style="font-size: 0.95rem; font-weight: 800; color: var(--primary);">
                  #<%= log.ticket.ticket_number %>
                </span>
                <span style="font-size: 0.95rem; font-weight: 700; color: var(--neutral-dark);">
                  <%= log.ticket.subject %>
                </span>
              </div>
              <p style="font-size: 0.85rem; color: var(--neutral-muted); margin: 0;">
                Müşteri: <strong><%= log.ticket.customer_name %></strong> (<%= log.ticket.customer_email %>) • Kategori: <strong><%= log.ticket.category %></strong>
              </p>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-size: 1.25rem;"><%= log.ai_agent.avatar %></span>
              <div>
                <strong style="color: var(--neutral-dark);"><%= log.ai_agent.name %></strong>
                <div style="font-size: 0.75rem; color: var(--neutral-muted);"><%= log.ai_agent.role_title %></div>
              </div>
            </div>
          </div>

          <div style="background: white; border: 1px solid #fde68a; border-radius: 6px; padding: 0.85rem; margin-bottom: 0.75rem;">
            <strong style="font-size: 0.8rem; color: #92400e; text-transform: uppercase;">🧠 Ajanın Akıl Yürütmesi (Chain of Thought):</strong>
            <pre style="white-space: pre-wrap; font-family: inherit; font-size: 0.85rem; color: #1e293b; margin: 0.35rem 0 0 0; line-height: 1.5;"><%= log.reasoning %></pre>
          </div>

          <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; padding: 0.85rem; margin-bottom: 1rem;">
            <strong style="font-size: 0.8rem; color: #065f46; text-transform: uppercase;">✨ Ajanın Hazırladığı Müşteri Yanıt Taslağı:</strong>
            <pre style="white-space: pre-wrap; font-family: inherit; font-size: 0.875rem; color: #047857; margin: 0.35rem 0 0 0; line-height: 1.55;"><%= log.suggested_reply %></pre>
          </div>

          <div style="display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <a href="<%= ticket_path(log.ticket) %>" class="btn btn-secondary btn-sm">
              Talebi Detaylı İncele
            </a>
            <%= button_to "✕ Öneriyi Reddet & Manuel Devral", reject_log_marketplace_path(log), method: :post, class: "btn btn-sm", style: "background: #ef4444; color: white;" %>
            <%= button_to "✓ Ajan Yanıtını Onayla ve Gönder", approve_log_marketplace_path(log), method: :post, class: "btn btn-success btn-sm", style: "font-weight: 700;" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card" style="text-align: center; padding: 3rem; color: var(--neutral-muted); margin-bottom: 2rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🎉</div>
      <h3 style="font-size: 1.15rem; color: var(--neutral-dark); margin-bottom: 0.25rem;">Onay bekleyen riskli talep bulunmuyor</h3>
      <p style="font-size: 0.85rem;">Kiralık ajanlarınız rutin biletleri otonom olarak güvenle çözmektedir.</p>
    </div>
  <% end %>
<% end %>

<!-- =================================================================================== -->
<!-- SEKME 4: CANLI AJAN İŞLEM AKIŞI (LOGLAR) -->
<!-- =================================================================================== -->
<% if @tab == "logs" %>
  <div class="card" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
      <div>
        <h3 style="font-size: 1.15rem; font-weight: 800; margin: 0; color: var(--neutral-dark); display: flex; align-items: center; gap: 0.5rem;">
          <span>📡</span> Canlı Ajan Karar ve İşlem Akışı (Chain of Thought Telemetrisi)
        </h3>
        <p style="font-size: 0.8rem; color: var(--neutral-muted); margin: 0.15rem 0 0 0;">
          Ajanların biletleri incelerken ürettikleri düşünce adımları, RAG eşleşmeleri ve güven skorları
        </p>
      </div>
      <span class="table-badge badge-info">Gerçek Zamanlı</span>
    </div>

    <% if @recent_logs.any? %>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Zaman</th>
              <th>Ajan</th>
              <th>Talep</th>
              <th>İşlem & Güven</th>
              <th>Akıl Yürütme (Chain of Thought)</th>
              <th>Durum</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_logs.each do |log| %>
              <tr>
                <td style="font-size: 0.75rem; color: var(--neutral-muted); white-space: nowrap;">
                  <%= log.created_at.strftime("%H:%M:%S") %>
                </td>
                <td style="white-space: nowrap;">
                  <span style="font-weight: 700; color: var(--neutral-dark);">
                    <%= log.ai_agent.avatar %> <%= log.ai_agent.name %>
                  </span>
                  <div style="font-size: 0.7rem; color: var(--neutral-muted);"><%= log.ai_agent.role_title.truncate(22) %></div>
                </td>
                <td>
                  <a href="<%= ticket_path(log.ticket) %>" style="font-weight: 600; color: var(--primary);">
                    #<%= log.ticket.ticket_number %>
                  </a>
                  <div style="font-size: 0.75rem; color: var(--neutral-dark);"><%= truncate(log.ticket.subject, length: 38) %></div>
                </td>
                <td>
                  <% action_labels = { "resolved" => "✓ Çözüldü", "replied_pending" => "💬 Yanıtlandı", "escalated_human" => "⚠️ HITL Onayına Sevk", "sla_triaged" => "⚡ Triyaj" } %>
                  <span class="table-badge badge-<%= log.action_taken == 'resolved' ? 'success' : (log.action_taken == 'escalated_human' ? 'warning' : 'info') %>">
                    <%= action_labels[log.action_taken] || log.action_taken %>
                  </span>
                  <div style="font-size: 0.7rem; color: var(--neutral-muted); margin-top: 0.2rem;">
                    Güven: <strong>%<%= log.confidence_score %></strong>
                  </div>
                </td>
                <td style="max-width: 380px;">
                  <div style="font-size: 0.775rem; color: #334155; line-height: 1.45; background: #f8fafc; padding: 0.45rem 0.65rem; border-radius: 4px; border: 1px solid #e2e8f0; font-family: monospace;">
                    <%= truncate(log.reasoning, length: 140) %>
                  </div>
                </td>
                <td>
                  <% if log.human_approved.nil? && log.action_taken == 'escalated_human' %>
                    <span class="table-badge badge-warning">Onay Bekliyor</span>
                  <% elsif log.human_approved == true %>
                    <span class="table-badge badge-success">Onaylandı</span>
                  <% elsif log.human_approved == false %>
                    <span class="table-badge badge-danger">Reddedildi</span>
                  <% else %>
                    <span class="table-badge badge-info">Otonom</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div style="text-align: center; padding: 2.5rem; color: var(--neutral-muted); font-size: 0.9rem;">
        Henüz bir işlem kaydı yok. Simülasyon başlatıldığında ajanların canlı düşünce adımları burada akacaktır.
      </div>
    <% end %>
  </div>
<% end %>
