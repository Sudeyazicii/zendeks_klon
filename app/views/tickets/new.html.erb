<% content_for :title, "Yeni Destek Talebi Oluştur" %>

<div style="max-width: 820px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <a href="<%= tickets_path %>" style="font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
      ← Destek Taleplerine Dön
    </a>
  </div>

  <div class="card" style="padding: 2.25rem;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
        <span style="font-size: 1.35rem;">🎫</span>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
          Yeni Destek Talebi Oluştur
        </h1>
      </div>
      <p style="font-size: 0.875rem; color: var(--neutral-muted); margin: 0;">
        Talebiniz kaydedildiğinde benzersiz bir numara (#PD-XXXX) ve önceliğe göre SLA süresi atanır.
      </p>
    </div>

    <%= form_with model: @ticket, local: true, multipart: true do |f| %>
      <% if @ticket.errors.any? %>
        <div class="flash-alert" style="margin-bottom: 1.75rem;">
          <strong>Hata oluştu:</strong>
          <ul style="margin-left: 1.25rem; margin-top: 0.35rem;">
            <% @ticket.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Müşteri Bilgileri -->
      <div style="margin-bottom: 1.75rem;">
        <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
          👤 1. Müşteri İletişim Bilgileri
        </h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :customer_name, "Müşteri Adı Soyadı", class: "form-label" %>
            <%= f.text_field :customer_name, placeholder: "Örn. Ahmet Yılmaz", class: "form-input", required: true %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :customer_email, "Müşteri E-posta Adresi", class: "form-label" %>
            <%= f.email_field :customer_email, placeholder: "ahmet@example.com", class: "form-input", required: true %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :customer_phone, "Telefon / WhatsApp No", class: "form-label" %>
            <%= f.text_field :customer_phone, placeholder: "05XXXXXXXXX", class: "form-input" %>
          </div>
        </div>
      </div>

      <!-- Kategori ve Öncelik / Kanal -->
      <div style="margin-bottom: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
          ⚙️ 2. Talep Sınıflandırması & SLA
        </h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :category, "Kategori", class: "form-label" %>
            <%= f.select :category, Ticket::CATEGORIES, {}, class: "form-select" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :channel, "İletişim Kanalı (Omnichannel)", class: "form-label" %>
            <%= f.select :channel, [
              ["🌐 Web Portalı", "web"],
              ["💬 WhatsApp", "whatsapp"],
              ["✉️ E-posta", "email"],
              ["🗨️ Canlı Sohbet (Live Chat)", "live_chat"],
              ["⚡ REST API", "api"]
            ], {}, class: "form-select" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :priority, "Öncelik Derecesi & SLA", class: "form-label" %>
            <%= f.select :priority, [
              ["Acil (Urgent) — 2 Saat SLA", "urgent"],
              ["Yüksek (High) — 4 Saat SLA", "high"],
              ["Orta (Medium) — 8 Saat SLA", "medium"],
              ["Düşük (Low) — 24 Saat SLA", "low"]
            ], {}, class: "form-select" %>
          </div>
        </div>
      </div>

      <!-- Mesai Saatleri ve Tatil Takvimi SLA Seçeneği -->
      <div style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid #a7f3d0; border-left: 4px solid #10b981; border-radius: var(--radius-md); padding: 1.15rem 1.25rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);">
        <label style="display: flex; align-items: center; gap: 0.65rem; font-weight: 700; color: #065f46; cursor: pointer; margin: 0; font-size: 0.95rem;">
          <%= f.check_box :use_business_hours, style: "width: 19px; height: 19px; accent-color: #059669; cursor: pointer;" %>
          <span>⏰ Kurumsal Mesai Saatleri & Tatil Takvimi SLA'sı Uygulansın</span>
        </label>
        <p style="font-size: 0.825rem; color: #047857; margin: 0.4rem 0 0 30px; line-height: 1.45;">
          İşaretlendiğinde SLA sayacı yalnızca hafta içi <strong>09:00 - 18:00</strong> arasında işler; hafta sonları ve Türkiye resmi tatilleri (1 Ocak, 23 Nisan, 29 Ekim vb.) hedef süreye dahil edilmez.
        </p>
      </div>

      <!-- Konu ve Açıklama -->
      <div style="margin-bottom: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
          📝 3. Talep Detayları
        </h3>
        <div class="form-group">
          <%= f.label :subject, "Talep Konusu", class: "form-label" %>
          <%= f.text_field :subject, placeholder: "Örn. Fatura görüntülenemiyor veya giriş hatası", class: "form-input", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :description, "Talep Açıklaması & Hata Detayları", class: "form-label" %>
          <%= f.text_area :description, placeholder: "Sorunu, karşılaşılan adımları ve detayları açıklayın...", class: "form-input", required: true, rows: 5 %>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :tags, "Etiketler (Virgülle ayırın)", class: "form-label" %>
            <%= f.text_field :tags, placeholder: "Örn. api, fatura, acil_ekip", class: "form-input" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :attachments, "Dosya Ekleri (Opsiyonel)", class: "form-label" %>
            <%= f.file_field :attachments, multiple: true, class: "form-input", style: "padding: 0.45rem 0.65rem;" %>
          </div>
        </div>
      </div>

      <!-- 100+ Puan Rubrik Özelliği: e-Fatura & GİB Entegrasyon Bilgileri -->
      <div style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 1px solid #fde68a; border-left: 4px solid #f59e0b; border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.75rem; box-shadow: var(--shadow-sm);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
          <h4 style="font-size: 0.95rem; font-weight: 800; color: #92400e; margin: 0; display: flex; align-items: center; gap: 0.4rem;">
            <span>🧾</span> e-Fatura / Muhasebe Entegrasyon Bilgileri
          </h4>
          <span class="table-badge" style="background: #fde68a; color: #92400e; font-weight: 700;">100+ Puan Adaptasyonu</span>
        </div>
        <p style="font-size: 0.825rem; color: #b45309; margin-bottom: 0.85rem; line-height: 1.45;">
          GİB e-Fatura itirazı veya onay süreci ile ilgili bir talep ise e-Fatura durumunu seçin; sistem <strong>7 günlük yasal GİB SLA süresini</strong> otomatik tanımlar.
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.85rem;">
          <div>
            <%= f.label :e_invoice_status, "e-Fatura Durumu", class: "form-label", style: "font-size: 0.8rem; color: #78350f;" %>
            <%= f.select :e_invoice_status, [
              ["e-Fatura İle İlgili Değil", "not_applicable"],
              ["GİB Onay Bekliyor (7 Günlük SLA)", "gib_pending"],
              ["e-Fatura Onaylandı", "approved"],
              ["e-Fatura Reddedildi / İptal", "rejected"]
            ], {}, class: "form-select", style: "font-size: 0.85rem;" %>
          </div>

          <div>
            <%= f.label :tax_number, "VKN / TCKN", class: "form-label", style: "font-size: 0.8rem; color: #78350f;" %>
            <%= f.text_field :tax_number, placeholder: "Örn: 1234567890", class: "form-input", style: "font-size: 0.85rem;" %>
          </div>

          <div>
            <%= f.label :invoice_number, "GİB Fatura No", class: "form-label", style: "font-size: 0.8rem; color: #78350f;" %>
            <%= f.text_field :invoice_number, placeholder: "Örn: GIB2026000012", class: "form-input", style: "font-size: 0.85rem;" %>
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border);">
        <a href="<%= tickets_path %>" class="btn btn-secondary">İptal</a>
        <%= f.submit "Talebi Kaydet ve Başlat", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
