<% content_for :title, "Destek Talepleri" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Destek Talepleri</h1>
    <p class="page-subtitle">Gelen müşteri destek talepleri, kategori, SLA süreleri ve çözüm iş akışı</p>
  </div>
  <div>
    <a href="<%= new_ticket_path %>" class="btn btn-primary">+ Yeni Talep Oluştur</a>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Toplam Talep</div>
    <div class="stat-value"><%= @total_count %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Yeni</div>
    <div class="stat-value" style="color: #2563eb;"><%= @new_count %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Açık (İnceleniyor)</div>
    <div class="stat-value" style="color: #d97706;"><%= @open_count %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Beklemede</div>
    <div class="stat-value" style="color: #7c3aed;"><%= @pending_count %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Çözüldü</div>
    <div class="stat-value" style="color: #059669;"><%= @solved_count %></div>
  </div>
  <div class="stat-card" style="border-left: 4px solid var(--danger);">
    <div class="stat-label" style="color: var(--danger);">SLA İhlali</div>
    <div class="stat-value" style="color: var(--danger);"><%= @breached_count %></div>
  </div>
</div>

<div class="card">
  <div class="filter-bar" style="flex-wrap: wrap; gap: 1rem;">
    <div class="filter-tabs" style="flex-wrap: wrap;">
      <a href="<%= tickets_path %>" class="filter-tab <%= 'active' if @status_filter.blank? %>">
        Tümü (<%= @total_count %>)
      </a>
      <a href="<%= tickets_path(status: 'new') %>" class="filter-tab <%= 'active' if @status_filter == 'new' %>">
        Yeni (<%= @new_count %>)
      </a>
      <a href="<%= tickets_path(status: 'open') %>" class="filter-tab <%= 'active' if @status_filter == 'open' %>">
        Açık (<%= @open_count %>)
      </a>
      <a href="<%= tickets_path(status: 'pending') %>" class="filter-tab <%= 'active' if @status_filter == 'pending' %>">
        Beklemede (<%= @pending_count %>)
      </a>
      <a href="<%= tickets_path(status: 'solved') %>" class="filter-tab <%= 'active' if @status_filter == 'solved' %>">
        Çözüldü (<%= @solved_count %>)
      </a>
      <a href="<%= tickets_path(status: 'closed') %>" class="filter-tab <%= 'active' if @status_filter == 'closed' %>">
        Kapatıldı (<%= @closed_count %>)
      </a>
      <a href="<%= tickets_path(status: 'unassigned') %>" class="filter-tab <%= 'active' if @status_filter == 'unassigned' %>">
        Atanmamış (<%= @unassigned_count %>)
      </a>
      <a href="<%= tickets_path(status: 'breached') %>" class="filter-tab <%= 'active' if @status_filter == 'breached' %>" style="color: var(--danger);">
        ⚠️ SLA İhlali (<%= @breached_count %>)
      </a>
      <a href="<%= tickets_path(e_invoice: 'gib_pending') %>" class="filter-tab <%= 'active' if @e_invoice_filter == 'gib_pending' %>" style="color: #d97706; font-weight: 700;">
        🧾 e-Fatura (GİB) (<%= @gib_pending_count %>)
      </a>
      <a href="<%= tickets_path(status: 'pending') %>" class="filter-tab <%= 'active' if @status_filter == 'pending' %>">
        ⏸️ SLA Duraklatıldı (<%= @paused_sla_count %>)
      </a>
    </div>

    <%= form_with url: tickets_path, method: :get, local: true, style: "display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;" do %>
      <select name="channel" class="form-select" onchange="this.form.submit()" style="font-size: 0.825rem; padding: 0.35rem 0.65rem;">
        <option value="">Tüm Kanallar (Omnichannel)</option>
        <option value="web" <%= 'selected' if params[:channel] == 'web' %>>🌐 Web Portalı</option>
        <option value="whatsapp" <%= 'selected' if params[:channel] == 'whatsapp' %>>💬 WhatsApp</option>
        <option value="email" <%= 'selected' if params[:channel] == 'email' %>>✉️ E-posta</option>
        <option value="live_chat" <%= 'selected' if params[:channel] == 'live_chat' %>>🗨️ Canlı Sohbet</option>
        <option value="api" <%= 'selected' if params[:channel] == 'api' %>>⚡ REST API</option>
      </select>
      <select name="category" class="form-select" onchange="this.form.submit()" style="font-size: 0.825rem; padding: 0.35rem 0.65rem;">
        <option value="">Tüm Kategoriler</option>
        <% Ticket::CATEGORIES.each do |cat| %>
          <option value="<%= cat %>" <%= 'selected' if params[:category] == cat %>><%= cat %></option>
        <% end %>
      </select>
      <%= text_field_tag :query, params[:query], placeholder: "No, konu veya müşteri...", class: "form-input", style: "padding: 0.35rem 0.65rem; font-size: 0.85rem; width: 180px;" %>
      <%= submit_tag "Filtrele", class: "btn btn-secondary btn-sm" %>
      <% if params[:query].present? || params[:status].present? || params[:category].present? || params[:channel].present? %>
        <a href="<%= tickets_path %>" class="btn btn-secondary btn-sm">Temizle</a>
      <% end %>
    <% end %>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Talep No</th>
          <th>Konu & Kategori</th>
          <th>Müşteri</th>
          <th>Atanan</th>
          <th>Öncelik</th>
          <th>Durum</th>
          <th>SLA Durumu</th>
          <th>Tarih</th>
          <th>İşlem</th>
        </tr>
      </thead>
      <tbody>
        <% if @tickets.any? %>
          <% @tickets.each do |ticket| %>
            <tr>
              <td>
                <strong style="color: var(--primary);">#<%= ticket.ticket_number %></strong>
                <% ch = ticket.channel_badge %>
                <br>
                <span class="table-badge <%= ch[:class] %>" style="font-size: 0.65rem; margin-top: 0.2rem;">
                  <%= ch[:icon] %> <%= ch[:text] %>
                </span>
                <% if ticket.use_business_hours? %>
                  <br>
                  <span class="table-badge badge-success" style="font-size: 0.65rem; margin-top: 0.15rem;">
                    ⏰ Mesai SLA
                  </span>
                <% end %>
                <% if ticket.community_question_id.present? %>
                  <br>
                  <span class="table-badge" style="background-color: #f3e8ff; color: #6b21a8; font-size: 0.65rem; margin-top: 0.15rem;">
                    Topluluktan Aktarıldı
                  </span>
                <% end %>
                <% if ticket.merged_into_ticket_id.present? %>
                  <br>
                  <span class="table-badge" style="background-color: #fef3c7; color: #92400e; font-size: 0.65rem; margin-top: 0.2rem;">
                    Birleştirildi (#PD-<%= ticket.merged_into_ticket&.ticket_number %>)
                  </span>
                <% end %>
              </td>
              <td>
                <div>
                  <a href="<%= ticket_path(ticket) %>" style="font-weight: 600; color: var(--neutral-dark);">
                    <%= ticket.subject %>
                  </a>
                </div>
                <div style="font-size: 0.775rem; color: var(--neutral-muted); margin-top: 0.15rem; display: flex; gap: 0.4rem; align-items: center;">
                  <span class="table-badge" style="background: #f1f5f9; color: #475569; font-size: 0.7rem;"><%= ticket.category %></span>
                  <% if ticket.tags.present? %>
                    <% ticket.tags.split(",").map(&:strip).each do |t| %>
                      <span class="table-badge badge-info" style="font-size: 0.65rem;"><%= t %></span>
                    <% end %>
                  <% end %>
                </div>
              </td>
              <td>
                <div style="font-weight: 500; font-size: 0.85rem;"><%= ticket.customer_name %></div>
                <div style="font-size: 0.75rem; color: var(--neutral-muted);"><%= ticket.customer_email %></div>
              </td>
              <td>
                <% if ticket.assigned_to.present? %>
                  <span style="font-size: 0.825rem; font-weight: 600; color: var(--neutral-dark);">
                    👤 <%= ticket.assigned_to.name.split.first %>
                  </span>
                <% else %>
                  <span style="font-size: 0.8rem; color: var(--neutral-muted); font-style: italic;">
                    Atanmamış
                  </span>
                <% end %>
              </td>
              <td>
                <% priority_tr = { "urgent" => "Acil", "high" => "Yüksek", "medium" => "Orta", "low" => "Düşük" } %>
                <span class="table-badge badge-<%= ticket.priority == 'urgent' || ticket.priority == 'high' ? 'danger' : 'info' %>">
                  <%= priority_tr[ticket.priority] || ticket.priority.upcase %>
                </span>
              </td>
              <td>
                <% status_tr = { "new" => "YENİ", "open" => "AÇIK", "pending" => "BEKLEMEDE", "solved" => "ÇÖZÜLDÜ", "closed" => "KAPATILDI" } %>
                <span class="table-badge badge-<%= ticket.solved? ? 'success' : (ticket.closed? ? 'info' : 'warning') %>">
                  <%= status_tr[ticket.status] || ticket.status.upcase %>
                </span>
              </td>
              <td>
                <% if ticket.sla_paused? %>
                  <span class="table-badge badge-warning" title="Müşteri bekleniyor, SLA sayacı duraklatıldı">
                    ⏸️ Duraklatıldı
                  </span>
                <% elsif ticket.breached? %>
                  <span class="table-badge badge-danger" title="SLA süresi aşıldı!">
                    ⚠️ İHLAL
                  </span>
                <% elsif ticket.solved? || ticket.closed? %>
                  <span class="table-badge badge-success">
                    ✓ Tamamlandı
                  </span>
                <% else %>
                  <% remaining = (ticket.sla_due_at - Time.current) / 3600.0 %>
                  <% if remaining > 0 %>
                    <span class="table-badge badge-info">
                      ⏱ <%= sprintf("%.1f", remaining) %> sa
                    </span>
                  <% else %>
                    <span class="table-badge badge-danger">İHLAL</span>
                  <% end %>
                <% end %>

                <% if ticket.first_response_breached? %>
                  <br><span class="table-badge badge-danger" style="font-size: 0.65rem; margin-top: 0.2rem;">İlk Yanıt Gecikti</span>
                <% end %>
                <% if ticket.e_invoice? %>
                  <br><span class="table-badge" style="background: #fef3c7; color: #92400e; font-size: 0.65rem; margin-top: 0.2rem;">🧾 e-Fatura</span>
                <% end %>
              </td>
              <td style="font-size: 0.775rem; color: var(--neutral-muted);">
                <%= ticket.created_at.strftime("%d.%m %H:%M") %>
              </td>
              <td>
                <div style="display: flex; gap: 0.35rem; align-items: center;">
                  <a href="<%= ticket_path(ticket) %>" class="btn btn-secondary btn-sm">Aç</a>
                  <% if current_user.admin? %>
                    <%= button_to "Sil", ticket_path(ticket), method: :delete, data: { turbo_confirm: "##{ticket.ticket_number} talebini silmek istediğinize emin misiniz?" }, class: "btn btn-sm", style: "background: var(--danger); color: white; padding: 0.25rem 0.45rem; font-size: 0.75rem;" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="9" style="text-align: center; padding: 2.5rem; color: var(--neutral-muted);">
              Bu filtrelere uygun destek talebi bulunamadı.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
