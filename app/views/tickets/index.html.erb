<% content_for :title, "Destek Talepleri" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Destek Talepleri</h1>
    <p class="page-subtitle">Gelen müşteri destek talepleri, kategori, SLA süreleri ve çözüm iş akışı</p>
  </div>
  <div>
    <a href="<%= new_ticket_path %>" class="btn btn-primary">+ Yeni Talep Oluştur</a>
  </div>
</div>

<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
  <div class="stat-card" style="border-top: 3px solid var(--neutral-dark);">
    <div style="font-size: 1.15rem; margin-bottom: 0.25rem;">🎫</div>
    <div class="stat-value"><%= @total_count %></div>
    <div class="stat-label">Toplam Talep</div>
  </div>
  <div class="stat-card" style="border-top: 3px solid #2563eb;">
    <div style="font-size: 1.15rem; margin-bottom: 0.25rem;">🆕</div>
    <div class="stat-value" style="color: #2563eb;"><%= @new_count %></div>
    <div class="stat-label">Yeni</div>
  </div>
  <div class="stat-card" style="border-top: 3px solid #d97706;">
    <div style="font-size: 1.15rem; margin-bottom: 0.25rem;">🔍</div>
    <div class="stat-value" style="color: #d97706;"><%= @open_count %></div>
    <div class="stat-label">Açık (İnceleniyor)</div>
  </div>
  <div class="stat-card" style="border-top: 3px solid #7c3aed;">
    <div style="font-size: 1.15rem; margin-bottom: 0.25rem;">⏸️</div>
    <div class="stat-value" style="color: #7c3aed;"><%= @pending_count %></div>
    <div class="stat-label">Beklemede</div>
  </div>
  <div class="stat-card" style="border-top: 3px solid #059669;">
    <div style="font-size: 1.15rem; margin-bottom: 0.25rem;">✅</div>
    <div class="stat-value" style="color: #059669;"><%= @solved_count %></div>
    <div class="stat-label">Çözüldü</div>
  </div>
  <div class="stat-card" style="border-top: 3px solid var(--danger);">
    <div style="font-size: 1.15rem; margin-bottom: 0.25rem;">⚠️</div>
    <div class="stat-value" style="color: var(--danger);"><%= @breached_count %></div>
    <div class="stat-label" style="color: var(--danger);">SLA İhlali</div>
  </div>
</div>

<div class="card">
  <!-- 1. Aşama: Durum Sekmeleri (Tabs) -->
  <div style="margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.85rem;">
    <div class="filter-tabs" style="display: flex; flex-wrap: wrap; gap: 0.35rem; background: transparent; padding: 0;">
      <a href="<%= tickets_path %>" class="filter-tab <%= 'active' if @status_filter.blank? && @e_invoice_filter.blank? %>">
        Tümü (<%= @total_count %>)
      </a>
      <a href="<%= tickets_path(status: 'new') %>" class="filter-tab <%= 'active' if @status_filter == 'new' %>">
        Yeni (<%= @new_count %>)
      </a>
      <a href="<%= tickets_path(status: 'open') %>" class="filter-tab <%= 'active' if @status_filter == 'open' %>">
        Açık (<%= @open_count %>)
      </a>
      <a href="<%= tickets_path(status: 'pending') %>" class="filter-tab <%= 'active' if @status_filter == 'pending' %>">
        Beklemede (<%= @pending_count %>)
      </a>
      <a href="<%= tickets_path(status: 'solved') %>" class="filter-tab <%= 'active' if @status_filter == 'solved' %>">
        Çözüldü (<%= @solved_count %>)
      </a>
      <a href="<%= tickets_path(status: 'closed') %>" class="filter-tab <%= 'active' if @status_filter == 'closed' %>">
        Kapatıldı (<%= @closed_count %>)
      </a>
      <a href="<%= tickets_path(status: 'unassigned') %>" class="filter-tab <%= 'active' if @status_filter == 'unassigned' %>">
        Atanmamış (<%= @unassigned_count %>)
      </a>
      <a href="<%= tickets_path(status: 'breached') %>" class="filter-tab <%= 'active' if @status_filter == 'breached' %>" style="color: var(--danger); font-weight: 700;">
        ⚠️ SLA İhlali (<%= @breached_count %>)
      </a>
      <a href="<%= tickets_path(e_invoice: 'gib_pending') %>" class="filter-tab <%= 'active' if @e_invoice_filter == 'gib_pending' %>" style="color: #d97706; font-weight: 700;">
        🧾 e-Fatura (GİB) (<%= @gib_pending_count %>)
      </a>
    </div>
  </div>

  <!-- 2. Aşama: Gelişmiş Arama ve Açılır Filtre Çubuğu (Toolbar) -->
  <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.65rem 0.85rem; margin-bottom: 1.25rem;">
    <%= form_with url: tickets_path, method: :get, local: true, html: { style: "display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;" } do %>
      <div style="flex: 1; min-width: 200px; max-width: 280px;">
        <%= text_field_tag :query, params[:query], placeholder: "🔍 No, konu veya müşteri...", class: "form-input", style: "width: 100%; font-size: 0.825rem; padding: 0.4rem 0.65rem; background: white;" %>
      </div>

      <div style="width: auto; min-width: 155px;">
        <select name="channel" class="form-select" onchange="this.form.submit()" style="width: 100%; font-size: 0.825rem; padding: 0.4rem 0.65rem; background-color: white;">
          <option value="">🌐 Tüm Kanallar</option>
          <option value="web" <%= 'selected' if params[:channel] == 'web' %>>Web Portalı</option>
          <option value="whatsapp" <%= 'selected' if params[:channel] == 'whatsapp' %>>💬 WhatsApp</option>
          <option value="email" <%= 'selected' if params[:channel] == 'email' %>>✉️ E-posta</option>
          <option value="live_chat" <%= 'selected' if params[:channel] == 'live_chat' %>>🗨️ Canlı Sohbet</option>
          <option value="api" <%= 'selected' if params[:channel] == 'api' %>>⚡ REST API</option>
        </select>
      </div>

      <div style="width: auto; min-width: 150px;">
        <select name="category" class="form-select" onchange="this.form.submit()" style="width: 100%; font-size: 0.825rem; padding: 0.4rem 0.65rem; background-color: white;">
          <option value="">📁 Tüm Kategoriler</option>
          <% Ticket::CATEGORIES.each do |cat| %>
            <option value="<%= cat %>" <%= 'selected' if params[:category] == cat %>><%= cat %></option>
          <% end %>
        </select>
      </div>

      <div style="width: auto; min-width: 160px;">
        <select name="department" class="form-select" onchange="this.form.submit()" style="width: 100%; font-size: 0.825rem; padding: 0.4rem 0.65rem; background-color: white;">
          <option value="">👥 Tüm Departmanlar</option>
          <option value="Destek Ekibi" <%= 'selected' if params[:department] == 'Destek Ekibi' %>>Destek Ekibi</option>
          <option value="Fatura & Muhasebe" <%= 'selected' if params[:department] == 'Fatura & Muhasebe' %>>Fatura & Muhasebe</option>
          <option value="Teknik & Altyapı" <%= 'selected' if params[:department] == 'Teknik & Altyapı' %>>Teknik & Altyapı</option>
          <option value="Yönetim" <%= 'selected' if params[:department] == 'Yönetim' %>>Yönetim</option>
        </select>
      </div>

      <div style="display: flex; gap: 0.35rem; align-items: center;">
        <%= submit_tag "Filtrele", class: "btn btn-primary btn-sm", style: "padding: 0.42rem 0.85rem;" %>
        <% if params[:query].present? || params[:status].present? || params[:category].present? || params[:channel].present? || params[:department].present? || params[:e_invoice].present? %>
          <a href="<%= tickets_path %>" class="btn btn-secondary btn-sm" style="padding: 0.42rem 0.65rem;">✕ Sıfırla</a>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Talep No</th>
          <th>Konu & Kategori</th>
          <th>Müşteri</th>
          <th>Atanan</th>
          <th>Öncelik</th>
          <th>Durum</th>
          <th>SLA Durumu</th>
          <th>Tarih</th>
          <th>İşlem</th>
        </tr>
      </thead>
      <tbody>
        <% if @tickets.any? %>
          <% @tickets.each do |ticket| %>
            <tr>
              <td style="white-space: nowrap;">
                <div style="font-weight: 800; font-size: 0.95rem; color: var(--primary); margin-bottom: 0.35rem;">
                  #<%= ticket.ticket_number %>
                </div>
                <div style="display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-start;">
                  <% ch = ticket.channel_badge %>
                  <span class="table-badge <%= ch[:class] %>" style="font-size: 0.7rem;">
                    <%= ch[:icon] %> <%= ch[:text] %>
                  </span>
                  <% if ticket.use_business_hours? %>
                    <span class="table-badge badge-success" style="font-size: 0.65rem;">
                      ⏰ Mesai SLA
                    </span>
                  <% end %>
                  <% if ticket.community_question_id.present? %>
                    <span class="table-badge" style="background-color: #f3e8ff; color: #6b21a8; font-size: 0.65rem;">
                      💬 Topluluk
                    </span>
                  <% end %>
                  <% if ticket.merged_into_ticket_id.present? %>
                    <span class="table-badge" style="background-color: #fef3c7; color: #92400e; font-size: 0.65rem;">
                      🔗 Birleştirildi
                    </span>
                  <% end %>
                </div>
              </td>
              <td>
                <div>
                  <a href="<%= ticket_path(ticket) %>" style="font-weight: 600; color: var(--neutral-dark);">
                    <%= ticket.subject %>
                  </a>
                </div>
                <div style="font-size: 0.775rem; color: var(--neutral-muted); margin-top: 0.15rem; display: flex; gap: 0.4rem; align-items: center;">
                  <span class="table-badge" style="background: #f1f5f9; color: #475569; font-size: 0.7rem;"><%= ticket.category %></span>
                  <% if ticket.tags.present? %>
                    <% ticket.tags.split(",").map(&:strip).each do |t| %>
                      <span class="table-badge badge-info" style="font-size: 0.65rem;"><%= t %></span>
                    <% end %>
                  <% end %>
                </div>
              </td>
              <td>
                <div style="font-weight: 500; font-size: 0.85rem;"><%= ticket.customer_name %></div>
                <div style="font-size: 0.75rem; color: var(--neutral-muted);"><%= ticket.customer_email %></div>
              </td>
              <td>
                <% if ticket.assigned_to.present? %>
                  <span style="font-size: 0.825rem; font-weight: 600; color: var(--neutral-dark);">
                    👤 <%= ticket.assigned_to.name.split.first %>
                  </span>
                <% else %>
                  <span style="font-size: 0.8rem; color: var(--neutral-muted); font-style: italic;">
                    Atanmamış
                  </span>
                <% end %>
              </td>
              <td>
                <% priority_tr = { "urgent" => "Acil", "high" => "Yüksek", "medium" => "Orta", "low" => "Düşük" } %>
                <span class="table-badge badge-<%= ticket.priority == 'urgent' || ticket.priority == 'high' ? 'danger' : 'info' %>">
                  <%= priority_tr[ticket.priority] || ticket.priority.upcase %>
                </span>
              </td>
              <td>
                <% status_tr = { "new" => "YENİ", "open" => "AÇIK", "pending" => "BEKLEMEDE", "solved" => "ÇÖZÜLDÜ", "closed" => "KAPATILDI" } %>
                <span class="table-badge badge-<%= ticket.solved? ? 'success' : (ticket.closed? ? 'info' : 'warning') %>">
                  <%= status_tr[ticket.status] || ticket.status.upcase %>
                </span>
              </td>
              <td>
                <% if ticket.sla_paused? %>
                  <span class="table-badge badge-warning" title="Müşteri bekleniyor, SLA sayacı duraklatıldı">
                    ⏸️ Duraklatıldı
                  </span>
                <% elsif ticket.breached? %>
                  <span class="table-badge badge-danger" title="SLA süresi aşıldı!">
                    ⚠️ İHLAL
                  </span>
                <% elsif ticket.solved? || ticket.closed? %>
                  <span class="table-badge badge-success">
                    ✓ Tamamlandı
                  </span>
                <% else %>
                  <% remaining = (ticket.sla_due_at - Time.current) / 3600.0 %>
                  <% if remaining > 0 %>
                    <span class="table-badge badge-info">
                      ⏱ <%= sprintf("%.1f", remaining) %> sa
                    </span>
                  <% else %>
                    <span class="table-badge badge-danger">İHLAL</span>
                  <% end %>
                <% end %>

                <% if ticket.first_response_breached? %>
                  <br><span class="table-badge badge-danger" style="font-size: 0.65rem; margin-top: 0.2rem;">İlk Yanıt Gecikti</span>
                <% end %>
                <% if ticket.e_invoice? %>
                  <br><span class="table-badge" style="background: #fef3c7; color: #92400e; font-size: 0.65rem; margin-top: 0.2rem;">🧾 e-Fatura</span>
                <% end %>
              </td>
              <td style="font-size: 0.775rem; color: var(--neutral-muted);">
                <%= ticket.created_at.strftime("%d.%m %H:%M") %>
              </td>
              <td>
                <div style="display: flex; gap: 0.35rem; align-items: center;">
                  <a href="<%= ticket_path(ticket) %>" class="btn btn-secondary btn-sm">Aç</a>
                  <% if current_user.admin? %>
                    <%= button_to "Sil", ticket_path(ticket), method: :delete, data: { turbo_confirm: "##{ticket.ticket_number} talebini silmek istediğinize emin misiniz?" }, class: "btn btn-sm", style: "background: var(--danger); color: white; padding: 0.25rem 0.45rem; font-size: 0.75rem;" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="9" style="text-align: center; padding: 2.5rem; color: var(--neutral-muted);">
              Bu filtrelere uygun destek talebi bulunamadı.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Sayfalama (Pagination) -->
  <% if @total_pages > 1 %>
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1.25rem; background: #f8fafc; border-top: 1px solid var(--border); font-size: 0.85rem; border-radius: 0 0 var(--radius-md) var(--radius-md);">
      <span style="color: var(--neutral-muted);">
        Toplam <strong><%= @total_filtered_count %></strong> talepten sayfa <strong><%= @page %> / <%= @total_pages %></strong>
      </span>
      <div style="display: flex; gap: 0.5rem;">
        <% if @page > 1 %>
          <%= link_to "← Önceki Sayfa", tickets_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-secondary btn-sm" %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to "Sonraki Sayfa →", tickets_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-secondary btn-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
