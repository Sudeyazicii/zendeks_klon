<% content_for :title, "Talebi Düzenle: ##{@ticket.ticket_number}" %>

<div style="max-width: 820px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <a href="<%= ticket_path(@ticket) %>" style="font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
      ← Talebe Dön (#<%= @ticket.ticket_number %>)
    </a>
  </div>

  <div class="card" style="padding: 2.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
          <span style="font-size: 1.35rem;">✏️</span>
          <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
            Talebi Düzenle: #<%= @ticket.ticket_number %>
          </h1>
        </div>
        <p style="font-size: 0.875rem; color: var(--neutral-muted); margin: 0;">
          Talep ayrıntılarını, önceliğini, kategorisini, atanan çalışanını ve etiketlerini güncelleyin.
        </p>
      </div>
      <span class="table-badge badge-info" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">
        <%= @ticket.status.upcase %>
      </span>
    </div>

    <%= form_with model: @ticket, local: true, multipart: true do |f| %>
      <% if @ticket.errors.any? %>
        <div class="flash-alert" style="margin-bottom: 1.75rem;">
          <strong>Hata oluştu:</strong>
          <ul style="margin-left: 1.25rem; margin-top: 0.35rem;">
            <% @ticket.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Müşteri Bilgileri -->
      <div style="margin-bottom: 1.75rem;">
        <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
          👤 1. Müşteri İletişim Bilgileri
        </h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :customer_name, "Müşteri Adı Soyadı", class: "form-label" %>
            <%= f.text_field :customer_name, class: "form-input", required: true %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :customer_email, "Müşteri E-posta Adresi", class: "form-label" %>
            <%= f.email_field :customer_email, class: "form-input", required: true %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :customer_phone, "Telefon / WhatsApp No", class: "form-label" %>
            <%= f.text_field :customer_phone, class: "form-input" %>
          </div>
        </div>
      </div>

      <!-- Kategori, Öncelik & Atama -->
      <div style="margin-bottom: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
          ⚙️ 2. Talep Sınıflandırması & Atama
        </h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :category, "Kategori", class: "form-label" %>
            <%= f.select :category, Ticket::CATEGORIES, {}, class: "form-select" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :channel, "İletişim Kanalı (Omnichannel)", class: "form-label" %>
            <%= f.select :channel, [
              ["🌐 Web Portalı", "web"],
              ["💬 WhatsApp", "whatsapp"],
              ["✉️ E-posta", "email"],
              ["🗨️ Canlı Sohbet (Live Chat)", "live_chat"],
              ["⚡ REST API", "api"]
            ], {}, class: "form-select" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :priority, "Öncelik Derecesi & SLA", class: "form-label" %>
            <%= f.select :priority, [
              ["Acil (Urgent) — 2 Saat SLA", "urgent"],
              ["Yüksek (High) — 4 Saat SLA", "high"],
              ["Orta (Medium) — 8 Saat SLA", "medium"],
              ["Düşük (Low) — 24 Saat SLA", "low"]
            ], {}, class: "form-select" %>
          </div>
        </div>

        <% if current_user.staff? %>
          <div class="form-group" style="margin-top: 1rem; margin-bottom: 0;">
            <%= f.label :assigned_to_id, "Atanan Destek Temsilcisi", class: "form-label" %>
            <%= f.collection_select :assigned_to_id, @agents, :id, :name, { include_blank: "Henüz Atanmadı" }, class: "form-select" %>
          </div>
        <% end %>
      </div>

      <!-- Mesai Saatleri ve Tatil Takvimi SLA Seçeneği -->
      <div style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid #a7f3d0; border-left: 4px solid #10b981; border-radius: var(--radius-md); padding: 1.15rem 1.25rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);">
        <label style="display: flex; align-items: center; gap: 0.65rem; font-weight: 700; color: #065f46; cursor: pointer; margin: 0; font-size: 0.95rem;">
          <%= f.check_box :use_business_hours, style: "width: 19px; height: 19px; accent-color: #059669; cursor: pointer;" %>
          <span>⏰ Kurumsal Mesai Saatleri & Tatil Takvimi SLA'sı Uygulansın</span>
        </label>
        <p style="font-size: 0.825rem; color: #047857; margin: 0.4rem 0 0 30px; line-height: 1.45;">
          İşaretlendiğinde SLA sayacı yalnızca hafta içi <strong>09:00 - 18:00</strong> arasında işler; hafta sonları ve Türkiye resmi tatilleri hedef süreye dahil edilmez.
        </p>
      </div>

      <!-- 100+ Puan Adaptasyonu: e-Fatura / GİB Entegrasyon Alanları -->
      <div style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 1px solid #fde68a; border-left: 4px solid #f59e0b; border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.75rem; box-shadow: var(--shadow-sm);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
          <h4 style="font-size: 0.95rem; font-weight: 800; color: #92400e; margin: 0; display: flex; align-items: center; gap: 0.4rem;">
            <span>🧾</span> 100+ Puan Adaptasyonu: e-Fatura & GİB Yasal İtiraz Takvimi
          </h4>
          <span class="table-badge" style="background: #fde68a; color: #92400e; font-weight: 700;">GİB 7 Günlük SLA</span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.85rem; margin-top: 0.75rem;">
          <div>
            <%= f.label :e_invoice_status, "e-Fatura Durumu", class: "form-label", style: "font-size: 0.8rem; color: #78350f;" %>
            <%= f.select :e_invoice_status, [
              ["Uygulanamaz (Standart Bilet)", "not_applicable"],
              ["GİB Onay Bekliyor (7 Gün Yasal SLA)", "gib_pending"],
              ["Onaylandı (approved)", "approved"],
              ["Reddedildi / İtiraz Edildi", "rejected"]
            ], {}, class: "form-select", style: "font-size: 0.85rem;" %>
          </div>

          <div>
            <%= f.label :tax_number, "VKN / TCKN No", class: "form-label", style: "font-size: 0.8rem; color: #78350f;" %>
            <%= f.text_field :tax_number, placeholder: "10 veya 11 hane", class: "form-input", style: "font-size: 0.85rem;" %>
          </div>

          <div>
            <%= f.label :invoice_number, "GİB Fatura No", class: "form-label", style: "font-size: 0.8rem; color: #78350f;" %>
            <%= f.text_field :invoice_number, placeholder: "GIB2026...", class: "form-input", style: "font-size: 0.85rem;" %>
          </div>
        </div>
      </div>

      <!-- Konu ve Açıklama -->
      <div style="margin-bottom: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
          📝 3. Talep Detayları
        </h3>

        <div class="form-group">
          <%= f.label :tags, "Etiketler (Virgülle ayırın)", class: "form-label" %>
          <%= f.text_field :tags, placeholder: "fatura, acil, v2_api, sso", class: "form-input" %>
        </div>

        <div class="form-group">
          <%= f.label :subject, "Talep Konusu", class: "form-label" %>
          <%= f.text_field :subject, class: "form-input", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :description, "Talep Açıklaması", class: "form-label" %>
          <%= f.text_area :description, class: "form-input", rows: 5, required: true %>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :attachments, "📎 Yeni Dosya Ekleri Ekle", class: "form-label" %>
          <%= f.file_field :attachments, multiple: true, class: "form-input", style: "padding: 0.45rem 0.65rem;" %>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border);">
        <a href="<%= ticket_path(@ticket) %>" class="btn btn-secondary">İptal</a>
        <%= f.submit "Değişiklikleri Kaydet", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
