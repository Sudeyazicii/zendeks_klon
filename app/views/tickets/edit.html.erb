<% content_for :title, "Talebi Düzenle: ##{@ticket.ticket_number}" %>

<div style="max-width: 760px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <a href="<%= ticket_path(@ticket) %>" style="font-size: 0.85rem; color: var(--neutral-muted);">
      ← Talebe Dön (#<%= @ticket.ticket_number %>)
    </a>
  </div>

  <div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
        Talebi Düzenle: #<%= @ticket.ticket_number %>
      </h1>
      <span class="table-badge badge-info"><%= @ticket.status.upcase %></span>
    </div>
    <p style="font-size: 0.875rem; color: var(--neutral-muted); margin-bottom: 1.5rem;">
      Talep ayrıntılarını, önceliğini, kategorisini, atanan çalışanını ve etiketlerini güncelleyin.
    </p>

    <%= form_with model: @ticket, local: true, multipart: true do |f| %>
      <% if @ticket.errors.any? %>
        <div class="flash-alert">
          <strong>Hata oluştu:</strong>
          <ul style="margin-left: 1.25rem; margin-top: 0.35rem;">
            <% @ticket.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :customer_name, "Müşteri Adı Soyadı", class: "form-label" %>
          <%= f.text_field :customer_name, class: "form-input", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :customer_email, "Müşteri E-posta Adresi", class: "form-label" %>
          <%= f.email_field :customer_email, class: "form-input", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :customer_phone, "Telefon / WhatsApp No", class: "form-label" %>
          <%= f.text_field :customer_phone, class: "form-input" %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :category, "Kategori", class: "form-label" %>
          <%= f.select :category, Ticket::CATEGORIES, {}, class: "form-select" %>
        </div>

        <div class="form-group">
          <%= f.label :channel, "İletişim Kanalı (Omnichannel)", class: "form-label" %>
          <%= f.select :channel, [
            ["🌐 Web Portalı", "web"],
            ["💬 WhatsApp", "whatsapp"],
            ["✉️ E-posta", "email"],
            ["🗨️ Canlı Sohbet (Live Chat)", "live_chat"],
            ["⚡ REST API", "api"]
          ], {}, class: "form-select" %>
        </div>

        <div class="form-group">
          <%= f.label :priority, "Öncelik Derecesi & SLA", class: "form-label" %>
          <%= f.select :priority, [
            ["Acil (Urgent) — 2 Saat SLA", "urgent"],
            ["Yüksek (High) — 4 Saat SLA", "high"],
            ["Orta (Medium) — 8 Saat SLA", "medium"],
            ["Düşük (Low) — 24 Saat SLA", "low"]
          ], {}, class: "form-select" %>
        </div>
      </div>

      <% if current_user.staff? %>
        <div class="form-group">
          <%= f.label :assigned_to_id, "Atanan Destek Temsilcisi", class: "form-label" %>
          <%= f.collection_select :assigned_to_id, @agents, :id, :name, { include_blank: "Henüz Atanmadı" }, class: "form-select" %>
        </div>
      <% end %>

      <!-- Mesai Saatleri ve Tatil Takvimi SLA Seçeneği -->
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius-sm); padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
        <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: #166534; cursor: pointer; margin: 0;">
          <%= f.check_box :use_business_hours, style: "width: 18px; height: 18px; accent-color: #16a34a;" %>
          <span>⏰ Kurumsal Mesai Saatleri & Tatil Takvimi SLA'sı Uygulansın</span>
        </label>
      </div>

      <!-- 100+ Puan Adaptasyonu: e-Fatura / GİB Entegrasyon Alanları -->
      <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.25rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
          <span style="font-size: 1.15rem;">🧾</span>
          <strong style="color: #92400e;">100+ Puan Adaptasyonu: e-Fatura & GİB Yasal İtiraz Takvimi</strong>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :e_invoice_status, "e-Fatura Durumu", class: "form-label" %>
            <%= f.select :e_invoice_status, [
              ["Uygulanamaz (Standart Bilet)", "not_applicable"],
              ["GİB Onay Bekliyor (7 Gün Yasal SLA)", "gib_pending"],
              ["Onaylandı (approved)", "approved"],
              ["Reddedildi / İtiraz Edildi", "rejected"]
            ], {}, class: "form-select" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :tax_number, "VKN / TCKN No", class: "form-label" %>
            <%= f.text_field :tax_number, placeholder: "10 veya 11 hane", class: "form-input" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :invoice_number, "GİB Fatura No", class: "form-label" %>
            <%= f.text_field :invoice_number, placeholder: "GIB2026...", class: "form-input" %>
          </div>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :tags, "Etiketler (Virgülle ayırın)", class: "form-label" %>
        <%= f.text_field :tags, placeholder: "fatura, acil, v2_api, sso", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :subject, "Talep Konusu", class: "form-label" %>
        <%= f.text_field :subject, class: "form-input", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :description, "Talep Açıklaması", class: "form-label" %>
        <%= f.text_area :description, class: "form-input", rows: 5, required: true %>
      </div>

      <div class="form-group">
        <%= f.label :attachments, "📎 Yeni Dosya Ekleri Ekle", class: "form-label" %>
        <%= f.file_field :attachments, multiple: true, class: "form-input", style: "padding: 0.4rem;" %>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="<%= ticket_path(@ticket) %>" class="btn btn-secondary">İptal</a>
        <%= f.submit "Değişiklikleri Kaydet", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
