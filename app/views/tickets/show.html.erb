<% content_for :title, "Talep ##{@ticket.ticket_number}: #{@ticket.subject}" %>

<div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
  <a href="<%= tickets_path %>" style="font-size: 0.85rem; color: var(--neutral-muted);">
    ← Destek Taleplerine Dön
  </a>
  <span style="font-size: 0.825rem; color: var(--neutral-muted);">
    Kategori: <strong><%= @ticket.category %></strong>
    <% if @ticket.tags.present? %>
      • Etiketler: <strong><%= @ticket.tags %></strong>
    <% end %>
  </span>
</div>

<!-- Mükerrer / Benzer Talep Uyarısı (G2 Şikâyeti Çözümü) -->
<% if @similar_tickets.any? && !@ticket.closed? %>
  <div class="duplicate-banner">
    <div class="duplicate-banner-content">
      <h4>⚠️ Benzer veya Mükerrer Talep Tespiti (Mükerrer İş Engelleme)</h4>
      <p>
        Bu müşteriye ait veya benzer konuda <%= @similar_tickets.size %> adet açık talep tespit edildi:
      </p>
      <div style="margin-top: 0.4rem; display: flex; flex-direction: column; gap: 0.35rem;">
        <% @similar_tickets.each do |sim| %>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: rgba(255,255,255,0.7); padding: 0.35rem 0.65rem; border-radius: 4px;">
            <span style="font-size: 0.825rem;">
              <strong>#<%= sim.ticket_number %>:</strong> <%= truncate(sim.subject, length: 50) %> (<%= sim.status.upcase %>)
            </span>
            <%= button_to "Bu Taleple Birleştir (Merge)", merge_ticket_path(@ticket, target_ticket_id: sim.id), method: :post, data: { turbo_confirm: "Bu talep ##{sim.ticket_number} ana talebiyle birleştirilerek kapatılacak. Onaylıyor musunuz?" }, class: "btn btn-sm", style: "background: #c2410c; color: white; padding: 0.2rem 0.5rem; font-size: 0.75rem;" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="card" style="margin-bottom: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
        <span style="font-size: 1.1rem; font-weight: 800; color: var(--primary);">
          #<%= @ticket.ticket_number %>
        </span>
        <% status_tr = { "new" => "YENİ", "open" => "AÇIK", "pending" => "BEKLEMEDE", "solved" => "ÇÖZÜLDÜ", "closed" => "KAPATILDI" } %>
        <span class="table-badge badge-<%= @ticket.solved? ? 'success' : (@ticket.closed? ? 'info' : 'warning') %>">
          <%= status_tr[@ticket.status] %>
        </span>
        <% priority_tr = { "urgent" => "Acil", "high" => "Yüksek", "medium" => "Orta", "low" => "Düşük" } %>
        <span class="table-badge badge-<%= @ticket.priority == 'urgent' || @ticket.priority == 'high' ? 'danger' : 'info' %>">
          <%= priority_tr[@ticket.priority] %>
        </span>
        <% if @ticket.breached? %>
          <span class="table-badge badge-danger">⚠️ SLA İHLALİ</span>
        <% end %>
        <% if @ticket.merged_into_ticket_id.present? %>
          <span class="table-badge" style="background: #fef3c7; color: #92400e;">
            Birleştirildi (#<%= @ticket.merged_into_ticket&.ticket_number %>)
          </span>
        <% end %>
      </div>
      <h1 style="font-size: 1.4rem; font-weight: 800; color: var(--neutral-dark);">
        <%= @ticket.subject %>
      </h1>
      <p style="font-size: 0.85rem; color: var(--neutral-muted); margin-top: 0.25rem;">
        Müşteri: <strong><%= @ticket.customer_name %></strong> (<%= @ticket.customer_email %>) • 
        Oluşturulma: <%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %>
      </p>
    </div>

    <!-- Durum Yönetimi & Atama Aksiyonları -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <% if current_user.staff? %>
        <!-- Hızlı Atama Formu -->
        <%= form_with url: assign_ticket_path(@ticket), method: :patch, local: true, style: "display: flex; gap: 0.35rem;" do %>
          <select name="agent_id" class="form-select" onchange="this.form.submit()" style="font-size: 0.8rem; padding: 0.35rem 0.5rem;">
            <option value="">👤 Temsilci Ata...</option>
            <% @agents.each do |ag| %>
              <option value="<%= ag.id %>" <%= 'selected' if @ticket.assigned_to_id == ag.id %>><%= ag.name %></option>
            <% end %>
          </select>
        <% end %>
      <% end %>

      <% if @ticket.status == "new" %>
        <%= button_to "İncelemeye Al (Açık Yap)", update_status_ticket_path(@ticket, status: "open"), method: :patch, class: "btn btn-primary btn-sm" %>
        <%= button_to "Müşteri Bekleniyor", update_status_ticket_path(@ticket, status: "pending"), method: :patch, class: "btn btn-secondary btn-sm" %>
      <% elsif @ticket.status == "open" %>
        <%= button_to "Beklemeye Al", update_status_ticket_path(@ticket, status: "pending"), method: :patch, class: "btn btn-secondary btn-sm" %>
        <%= button_to "✓ Talebi Çöz", update_status_ticket_path(@ticket, status: "solved"), method: :patch, class: "btn btn-success btn-sm" %>
        <%= button_to "Kapat", close_ticket_path(@ticket), method: :patch, class: "btn btn-secondary btn-sm" %>
      <% elsif @ticket.status == "pending" %>
        <%= button_to "Talebi Aç", update_status_ticket_path(@ticket, status: "open"), method: :patch, class: "btn btn-primary btn-sm" %>
        <%= button_to "✓ Talebi Çöz", update_status_ticket_path(@ticket, status: "solved"), method: :patch, class: "btn btn-success btn-sm" %>
      <% elsif @ticket.status == "solved" %>
        <%= button_to "↺ Yeniden Aç", reopen_ticket_path(@ticket), method: :post, class: "btn btn-secondary btn-sm" %>
        <%= button_to "Talebi Kapat", close_ticket_path(@ticket), method: :patch, class: "btn btn-secondary btn-sm" %>
      <% elsif @ticket.status == "closed" %>
        <%= button_to "↺ Yeniden Aç", reopen_ticket_path(@ticket), method: :post, class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>
  </div>

  <% if @ticket.community_question.present? %>
    <div style="margin-top: 1rem; padding: 0.75rem 1rem; background-color: #f5f3ff; border: 1px solid #ddd6fe; border-radius: var(--radius-sm); font-size: 0.85rem;">
      💬 <strong>Topluluk Forumu Kaynağı:</strong> 
      Bu talep 
      <a href="<%= community_question_path(@ticket.community_question) %>" style="font-weight: 600;">
        "<%= @ticket.community_question.title %>"
      </a> 
      sorusunun 24 saat yanıtsız kalması üzerine otomatik oluşturulmuştur.
    </div>
  <% end %>

  <!-- SLA Göstergesi Bilgi Çubuğu -->
  <div style="margin-top: 1.25rem; padding: 0.85rem 1rem; background-color: #f8fafc; border-radius: var(--radius-sm); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="font-size: 0.85rem;">
      <strong>SLA Bitiş Süresi:</strong> <%= @ticket.sla_due_at.strftime("%d.%m.%Y %H:%M") %>
      <% if @ticket.first_responded_at.present? %>
        • <strong>İlk Yanıt:</strong> <%= @ticket.first_responded_at.strftime("%d.%m.%Y %H:%M") %>
      <% end %>
      <% if @ticket.assigned_to.present? %>
        • <strong>Atanan:</strong> <%= @ticket.assigned_to.name %>
      <% end %>
    </div>
    <div>
      <% if @ticket.breached? %>
        <span class="table-badge badge-danger">SLA HEDEFİ AŞILDI (İHLAL)</span>
      <% elsif @ticket.solved? || @ticket.closed? %>
        <span class="table-badge badge-success">TAMAMLANDI</span>
      <% else %>
        <span class="table-badge badge-info">
          ⏱ Kalan: <%= sprintf("%.1f", [(@ticket.sla_due_at - Time.current) / 3600.0, 0].max) %> Saat
        </span>
      <% end %>
    </div>
  </div>
</div>

<!-- Bilgi Bankası Öneri Kutusu (AI / Anahtar Kelime Eşleşmesi) -->
<% if @relevant_articles.any? && current_user.staff? %>
  <div class="kb-suggestions">
    <h4>💡 İlgili Bilgi Bankası Makaleleri</h4>
    <ul class="kb-list">
      <% @relevant_articles.each do |art| %>
        <li>
          • <strong><%= art.title %></strong> (<%= art.category %>)
          <div style="font-size: 0.8rem; color: #166534;"><%= truncate(art.body, length: 100) %></div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<!-- Talep Açıklaması & Konuşma Geçmişi -->
<div class="card">
  <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--neutral-dark);">
    Talep Açıklaması & Konuşma Geçmişi
  </h2>

  <!-- İlk Talep Açıklaması -->
  <div class="timeline-card" style="background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem;">
    <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--neutral-muted); margin-bottom: 0.5rem;">
      <span style="font-weight: 700; color: var(--neutral-dark);">👤 <%= @ticket.customer_name %> (Müşteri Bildirimi)</span>
      <span><%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
    </div>
    <div style="font-size: 0.925rem; white-space: pre-wrap; color: var(--neutral-text);">
      <%= @ticket.description %>
    </div>
  </div>

  <!-- Yanıtlar ve Dahili Notlar -->
  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
    <% @comments.each do |comment| %>
      <%# Müşteri rolündeki kullanıcılar dahili notları göremez! %>
      <% next if comment.is_internal_note? && current_user.customer? %>

      <div class="timeline-card <%= 'internal-note' if comment.is_internal_note? %>" style="border-radius: var(--radius-sm); padding: 1rem; border: 1px solid var(--border); <%= comment.is_internal_note? ? '' : (comment.author_role == 'agent' ? 'background: #f8fafc;' : 'background: white;') %>">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--neutral-muted); margin-bottom: 0.5rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-weight: 700; color: var(--neutral-dark);">
              <% if comment.author_role == "agent" %>
                🛡️ <%= comment.author_name %> (Destek Temsilcisi)
              <% else %>
                👤 <%= comment.author_name %> (Müşteri)
              <% end %>
            </span>
            <% if comment.is_internal_note? %>
              <span class="internal-note-badge">🔒 Dahili Not (Müşteri Göremez)</span>
            <% end %>
          </div>
          <span><%= comment.created_at.strftime("%d.%m.%Y %H:%M") %></span>
        </div>
        <div style="font-size: 0.925rem; white-space: pre-wrap; color: var(--neutral-text);">
          <%= comment.body %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Yanıt / Dahili Not Ekleme Formu -->
  <% unless @ticket.closed? %>
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1rem; font-weight: 700;">
          <%= current_user.staff? ? "Yanıt veya Dahili Not Yaz" : "Yanıtınızı İletin" %>
        </h3>

        <% if current_user.staff? && @canned_responses.any? %>
          <!-- Hazır Yanıt (Macro) Seçici -->
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <label style="font-size: 0.8rem; color: var(--neutral-muted); font-weight: 600;">Hazır Yanıt (Makro):</label>
            <select id="canned-select" class="form-select" style="font-size: 0.8rem; padding: 0.3rem 0.5rem;" onchange="insertCannedResponse(this.value)">
              <option value="">Seçiniz...</option>
              <% @canned_responses.each do |cr| %>
                <option value="<%= cr.content %>"><%= cr.title %></option>
              <% end %>
            </select>
          </div>
        <% end %>
      </div>

      <%= form_with model: [@ticket, @new_comment], local: true do |f| %>
        <%= f.hidden_field :author_name, value: current_user.name %>
        <%= f.hidden_field :author_role, value: current_user.staff? ? "agent" : "customer" %>

        <% if current_user.staff? %>
          <div style="display: flex; gap: 1.5rem; margin-bottom: 0.75rem; font-size: 0.85rem; font-weight: 600;">
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
              <%= f.radio_button :is_internal_note, false, checked: true %>
              📢 Herkese Açık Yanıt (Müşteri görür)
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; color: #b45309;">
              <%= f.radio_button :is_internal_note, true %>
              🔒 Dahili Not (Sadece ekip görür)
            </label>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.text_area :body, id: "comment-textarea", placeholder: current_user.staff? ? "Yanıtınızı veya dahili notunuzu buraya yazın..." : "Destek ekibine iletilecek mesajınızı yazın...", class: "form-input", required: true, rows: 4 %>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <%= f.submit "Mesajı Kaydet ve Gönder", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div style="margin-top: 1.5rem; padding: 1rem; background: #f8fafc; border-radius: var(--radius-sm); text-align: center; color: var(--neutral-muted); font-size: 0.85rem;">
      🔒 Bu talep kapatılmıştır. Yeni yanıt eklemek için yukarıdaki butondan talebi yeniden açabilirsiniz.
    </div>
  <% end %>
</div>

<script>
  function insertCannedResponse(content) {
    if (!content) return;
    const textarea = document.getElementById('comment-textarea');
    if (textarea) {
      textarea.value = content;
      textarea.focus();
    }
  }
</script>
