<% content_for :title, "Talep ##{@ticket.ticket_number}: #{@ticket.subject}" %>

<div style="margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
  <a href="<%= tickets_path %>" style="font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
    ← Destek Taleplerine Dön
  </a>
  <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; color: var(--neutral-muted);">
    <span class="table-badge badge-secondary">Kategori: <strong><%= @ticket.category %></strong></span>
    <% if @ticket.tags.present? %>
      <span class="table-badge badge-info">Etiketler: <strong><%= @ticket.tags %></strong></span>
    <% end %>
  </div>
</div>

<!-- Mükerrer / Benzer Talep Uyarısı (G2 Şikâyeti Çözümü) -->
<% if @similar_tickets.any? && !@ticket.closed? %>
  <div class="duplicate-banner" style="margin-bottom: 1.5rem;">
    <div class="duplicate-banner-content" style="width: 100%;">
      <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.35rem;">
        <span style="font-size: 1.1rem;">⚠️</span>
        <h4 style="margin: 0; color: #9a3412;">Benzer veya Mükerrer Talep Tespiti (Mükerrer İş Engelleme)</h4>
      </div>
      <p style="margin-bottom: 0.75rem;">
        Bu müşteriye ait veya benzer konuda <%= @similar_tickets.size %> adet açık talep tespit edildi:
      </p>
      <div style="display: flex; flex-direction: column; gap: 0.4rem;">
        <% @similar_tickets.each do |sim| %>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: rgba(255,255,255,0.85); padding: 0.5rem 0.85rem; border-radius: 6px; border: 1px solid #fed7aa;">
            <span style="font-size: 0.85rem; color: #7c2d12;">
              <strong>#<%= sim.ticket_number %>:</strong> <%= truncate(sim.subject, length: 55) %> (<%= sim.status.upcase %>)
            </span>
            <%= button_to "Bu Taleple Birleştir (Merge)", merge_ticket_path(@ticket, target_ticket_id: sim.id), method: :post, data: { turbo_confirm: "Bu talep ##{sim.ticket_number} ana talebiyle birleştirilerek kapatılacak. Onaylıyor musunuz?" }, class: "btn btn-sm", style: "background: #c2410c; color: white; padding: 0.25rem 0.65rem; font-size: 0.75rem; border-radius: 4px;" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- Ana Bilet Başlık Kartı -->
<div class="card" style="padding: 1.75rem; margin-bottom: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 300px;">
      <!-- Rozetler Dizisi -->
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.65rem; flex-wrap: wrap;">
        <span style="font-size: 1.15rem; font-weight: 800; color: var(--primary); letter-spacing: -0.02em;">
          #<%= @ticket.ticket_number %>
        </span>
        <% status_tr = { "new" => "YENİ", "open" => "AÇIK", "pending" => "BEKLEMEDE", "solved" => "ÇÖZÜLDÜ", "closed" => "KAPATILDI" } %>
        <span class="table-badge badge-<%= @ticket.solved? ? 'success' : (@ticket.closed? ? 'info' : 'warning') %>">
          <%= status_tr[@ticket.status] %>
        </span>
        <% priority_tr = { "urgent" => "Acil", "high" => "Yüksek", "medium" => "Orta", "low" => "Düşük" } %>
        <span class="table-badge badge-<%= @ticket.priority == 'urgent' || @ticket.priority == 'high' ? 'danger' : 'info' %>">
          <%= priority_tr[@ticket.priority] %>
        </span>
        <% ch = @ticket.channel_badge %>
        <span class="table-badge <%= ch[:class] %>">
          <%= ch[:icon] %> <%= ch[:text] %>
        </span>
        <% if @ticket.use_business_hours? %>
          <span class="table-badge badge-success">
            ⏰ Mesai & Tatil Takvimi SLA
          </span>
        <% end %>
        <% if @ticket.breached? %>
          <span class="table-badge badge-danger">⚠️ SLA İHLALİ</span>
        <% end %>
        <% if @ticket.e_invoice? %>
          <span class="table-badge <%= @ticket.e_invoice_status_badge ? @ticket.e_invoice_status_badge[:class] : 'badge-warning' %>">
            🧾 <%= @ticket.e_invoice_status_badge ? @ticket.e_invoice_status_badge[:text] : 'e-Fatura' %>
          </span>
        <% end %>
        <% if @ticket.merged_into_ticket_id.present? %>
          <span class="table-badge" style="background: #fef3c7; color: #92400e;">
            🔗 Birleştirildi (#<%= @ticket.merged_into_ticket&.ticket_number %>)
          </span>
        <% end %>
      </div>

      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); line-height: 1.35; margin-bottom: 0.5rem;">
        <%= @ticket.subject %>
      </h1>

      <p style="font-size: 0.85rem; color: var(--neutral-muted); margin: 0; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span>Müşteri: <strong style="color: var(--neutral-text);"><%= @ticket.customer_name %></strong> (<%= @ticket.customer_email %>)</span>
        <% if @ticket.customer_phone.present? %>
          <span>• Tel: <strong style="color: var(--neutral-text);"><%= @ticket.customer_phone %></strong></span>
        <% end %>
        <span>• Oluşturulma: <%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
      </p>
    </div>

    <!-- Durum Yönetimi & Atama Aksiyonları -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <% if current_user.staff? %>
        <!-- Hızlı Atama Formu -->
        <%= form_with url: assign_ticket_path(@ticket), method: :patch, local: true, style: "display: flex; gap: 0.35rem;" do %>
          <select name="agent_id" class="form-select" onchange="this.form.submit()" style="font-size: 0.825rem; padding: 0.4rem 0.65rem; border-radius: var(--radius-sm); font-weight: 600;">
            <option value="">👤 Temsilci Ata...</option>
            <% @agents.each do |ag| %>
              <option value="<%= ag.id %>" <%= 'selected' if @ticket.assigned_to_id == ag.id %>><%= ag.name %></option>
            <% end %>
          </select>
        <% end %>
      <% end %>

      <%= link_to "✏️ Düzenle", edit_ticket_path(@ticket), class: "btn btn-secondary btn-sm" %>

      <% if @ticket.status == "new" %>
        <%= button_to "İncelemeye Al (Açık Yap)", update_status_ticket_path(@ticket, status: "open"), method: :patch, class: "btn btn-primary btn-sm" %>
        <%= button_to "Müşteri Bekleniyor (SLA Duraklat)", update_status_ticket_path(@ticket, status: "pending"), method: :patch, class: "btn btn-secondary btn-sm" %>
      <% elsif @ticket.status == "open" %>
        <%= button_to "Beklemeye Al (SLA Duraklat)", update_status_ticket_path(@ticket, status: "pending"), method: :patch, class: "btn btn-secondary btn-sm" %>
        <%= button_to "✓ Talebi Çöz", update_status_ticket_path(@ticket, status: "solved"), method: :patch, class: "btn btn-success btn-sm" %>
        <%= button_to "Kapat", close_ticket_path(@ticket), method: :patch, class: "btn btn-secondary btn-sm" %>
      <% elsif @ticket.status == "pending" %>
        <%= button_to "Talebi Aç (SLA Devam Et)", update_status_ticket_path(@ticket, status: "open"), method: :patch, class: "btn btn-primary btn-sm" %>
        <%= button_to "✓ Talebi Çöz", update_status_ticket_path(@ticket, status: "solved"), method: :patch, class: "btn btn-success btn-sm" %>
      <% elsif @ticket.status == "solved" %>
        <%= button_to "↺ Yeniden Aç", reopen_ticket_path(@ticket), method: :post, class: "btn btn-secondary btn-sm" %>
        <%= button_to "Talebi Kapat", close_ticket_path(@ticket), method: :patch, class: "btn btn-secondary btn-sm" %>
      <% elsif @ticket.status == "closed" %>
        <%= button_to "↺ Yeniden Aç", reopen_ticket_path(@ticket), method: :post, class: "btn btn-secondary btn-sm" %>
      <% end %>

      <% if current_user.admin? %>
        <%= button_to "Sil", ticket_path(@ticket), method: :delete, data: { turbo_confirm: "##{@ticket.ticket_number} talebini tamamen silmek istediğinize emin misiniz?" }, class: "btn btn-sm", style: "background: var(--danger); color: white;" %>
      <% end %>
    </div>
  </div>

  <!-- SLA Bilgi Şeridi -->
  <div style="margin-top: 1.5rem; padding: 0.85rem 1.15rem; background-color: #f8fafc; border-radius: var(--radius-sm); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="font-size: 0.85rem; color: var(--neutral-text);">
      <strong>Çözüm SLA Hedefi:</strong> <span style="font-weight: 700; color: var(--primary);"><%= @ticket.sla_due_at.strftime("%d.%m.%Y %H:%M") %></span>
      <% if @ticket.first_response_due_at.present? %>
        • <strong>İlk Yanıt Hedefi:</strong> <%= @ticket.first_response_due_at.strftime("%H:%M") %>
      <% end %>
      <% if @ticket.first_responded_at.present? %>
        • <strong>İlk Yanıt Verildi:</strong> <%= @ticket.first_responded_at.strftime("%d.%m.%Y %H:%M") %>
      <% end %>
      <% if @ticket.total_paused_seconds > 0 %>
        • <strong>Toplam Duraklatma:</strong> <%= sprintf("%.1f", @ticket.total_paused_seconds / 3600.0) %> sa
      <% end %>
    </div>
    <div>
      <% if @ticket.sla_paused? %>
        <span class="table-badge badge-warning" style="font-size: 0.8rem;">
          ⏸️ MÜŞTERİ BEKLENİYOR (SLA DURAKLATILDI)
        </span>
      <% elsif @ticket.breached? %>
        <span class="table-badge badge-danger" style="font-size: 0.8rem;">SLA HEDEFİ AŞILDI (İHLAL)</span>
      <% elsif @ticket.solved? || @ticket.closed? %>
        <span class="table-badge badge-success" style="font-size: 0.8rem;">TAMAMLANDI</span>
      <% else %>
        <span class="table-badge badge-info" style="font-size: 0.8rem;">
          ⏱ Kalan Süre: <%= sprintf("%.1f", [(@ticket.sla_due_at - Time.current) / 3600.0, 0].max) %> Saat
        </span>
      <% end %>
    </div>
  </div>

  <!-- 🤖 PulseAI Asistanı & Analiz Kartı -->
  <div style="margin-top: 1.25rem; padding: 1.15rem 1.25rem; background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%); border: 1px solid #c4b5fd; border-radius: var(--radius-sm);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.25rem;">🤖</span>
        <strong style="color: #5b21b6; font-size: 0.95rem;">PulseAI Destek Asistanı & Doğal Dil Analizi</strong>
        <% if @ticket.ai_sentiment.present? %>
          <span class="table-badge" style="background: #e0e7ff; color: #3730a3; font-size: 0.75rem;">
            Duygu: <%= @ticket.ai_sentiment %>
          </span>
        <% end %>
      </div>
      <div style="display: flex; gap: 0.5rem;">
        <%= button_to "🤖 Talebi Özetle", ai_summarize_ticket_path(@ticket), method: :post, class: "btn btn-sm", style: "background: #7c3aed; color: white; padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px;" %>
        <%= button_to "✍️ AI Yanıt Taslağı Üret", ai_draft_reply_ticket_path(@ticket), method: :post, class: "btn btn-sm", style: "background: #4f46e5; color: white; padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px;" %>
      </div>
    </div>

    <% if @ticket.ai_summary.present? %>
      <div style="margin-top: 0.85rem; background: white; border: 1px solid #ddd6fe; border-radius: 6px; padding: 0.85rem 1rem; box-shadow: var(--shadow-sm);">
        <pre style="white-space: pre-wrap; font-family: inherit; margin: 0; font-size: 0.85rem; color: #334155; line-height: 1.55;"><%= @ticket.ai_summary %></pre>
      </div>
    <% end %>

    <% if @ai_draft.present? %>
      <div style="margin-top: 0.85rem; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; padding: 0.85rem 1rem; box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <strong style="color: #065f46; font-size: 0.85rem;">✨ Üretilen AI Yanıt Taslağı:</strong>
          <button type="button" onclick="insertCannedResponse(<%= @ai_draft.to_json %>)" class="btn btn-sm" style="background: #10b981; color: white; font-size: 0.75rem; padding: 0.25rem 0.55rem; border-radius: 4px;">
            Yanıt Kutusuna Kopyala
          </button>
        </div>
        <pre style="white-space: pre-wrap; font-family: inherit; margin: 0; font-size: 0.85rem; color: #047857; line-height: 1.55;"><%= @ai_draft %></pre>
      </div>
    <% end %>
  </div>

  <% if @ticket.e_invoice? %>
    <!-- 100+ Puan Adaptasyonu: e-Fatura / GİB Entegrasyon Kartı -->
    <div style="margin-top: 1rem; padding: 1rem 1.25rem; background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 1px solid #fde68a; border-left: 4px solid #f59e0b; border-radius: var(--radius-sm); font-size: 0.85rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <div>
          <strong style="color: #92400e; font-size: 0.9rem;">🧾 e-Fatura Bilgileri:</strong>
          <% if @ticket.tax_number.present? %>
            • VKN/TCKN: <strong style="color: #78350f;"><%= @ticket.tax_number %></strong>
          <% end %>
          <% if @ticket.invoice_number.present? %>
            • GİB Fatura No: <strong style="color: #78350f;"><%= @ticket.invoice_number %></strong>
          <% end %>
        </div>
        <div>
          <span class="table-badge <%= @ticket.e_invoice_status_badge ? @ticket.e_invoice_status_badge[:class] : 'badge-warning' %>">
            <%= @ticket.e_invoice_status_badge ? @ticket.e_invoice_status_badge[:text] : 'e-Fatura' %>
          </span>
        </div>
      </div>
      <% if @ticket.gib_pending? %>
        <div style="margin-top: 0.4rem; font-size: 0.8rem; color: #b45309;">
          ℹ️ GİB e-Fatura itiraz/onay yasal süreci kapsamında bu bilet için <strong>7 günlük (168 saat)</strong> özel SLA takvimi işletilmektedir.
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @ticket.community_question.present? %>
    <div style="margin-top: 1rem; padding: 0.85rem 1.15rem; background-color: #f5f3ff; border: 1px solid #ddd6fe; border-left: 4px solid #8b5cf6; border-radius: var(--radius-sm); font-size: 0.85rem;">
      💬 <strong>Topluluk Forumu Kaynağı:</strong> 
      Bu talep 
      <a href="<%= community_question_path(@ticket.community_question) %>" style="font-weight: 700; color: #6d28d9;">
        "<%= @ticket.community_question.title %>"
      </a> 
      sorusunun 24 saat yanıtsız kalması üzerine otomatik oluşturulmuştur.
    </div>
  <% end %>

  <!-- Bilgi Bankasından İlgili Makale Önerisi (Self-Servis & Hızlı Çözüm) -->
  <% if @suggested_articles.present? && @suggested_articles.any? %>
    <div style="margin-top: 1rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #10b981; border-radius: var(--radius-sm); padding: 1rem 1.15rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.65rem; flex-wrap: wrap; gap: 0.5rem;">
        <strong style="font-size: 0.875rem; color: #166534; display: flex; align-items: center; gap: 0.4rem;">
          📚 Bilgi Bankasından İlgili Makale Önerileri (Akıllı Eşleşme)
        </strong>
        <span style="font-size: 0.75rem; color: #15803d; font-weight: 600;"><%= @suggested_articles.size %> ilgili makale bulundu</span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.4rem;">
        <% @suggested_articles.each do |art| %>
          <div style="display: flex; align-items: center; justify-content: space-between; background: white; padding: 0.5rem 0.85rem; border-radius: 6px; border: 1px solid #dcfce7;">
            <div>
              <a href="<%= article_path(art) %>" target="_blank" style="font-size: 0.85rem; font-weight: 600; color: #15803d; text-decoration: none;">
                📖 <%= art.title %>
              </a>
              <span style="font-size: 0.75rem; color: #64748b; margin-left: 0.5rem;">(<%= art.category %>)</span>
            </div>
            <span style="font-size: 0.75rem; color: #64748b;">👁️ <%= art.views_count %> görüntülenme</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Talep Açıklaması & Konuşma Geçmişi -->
<div class="card" style="padding: 1.75rem;">
  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
    <span style="font-size: 1.2rem;">💬</span>
    <h2 style="font-size: 1.2rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
      Talep Açıklaması & Konuşma Geçmişi
    </h2>
  </div>

  <!-- İlk Talep Açıklaması -->
  <div class="timeline-card" style="background: #ffffff; border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius-sm); padding: 1.25rem; margin-bottom: 1.25rem; box-shadow: var(--shadow-sm);">
    <div style="display: flex; justify-content: space-between; font-size: 0.825rem; color: var(--neutral-muted); margin-bottom: 0.65rem;">
      <span style="font-weight: 700; color: var(--neutral-dark);">👤 <%= @ticket.customer_name %> (Müşteri Bildirimi)</span>
      <span><%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
    </div>
    <div style="font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; color: var(--neutral-text);">
      <%= @ticket.description %>
    </div>

    <!-- Bilet Dosya Ekleri -->
    <% if @ticket.attachments.attached? %>
      <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dashed #cbd5e1;">
        <strong style="font-size: 0.8rem; color: #64748b;">📎 Ekli Dosyalar:</strong>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.35rem;">
          <% @ticket.attachments.each do |att| %>
            <a href="<%= rails_blob_path(att, disposition: 'attachment') %>" target="_blank" class="table-badge badge-info" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.6rem;">
              📄 <%= att.filename %> (<%= number_to_human_size(att.byte_size) %>)
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Yanıtlar ve Dahili Notlar -->
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% @comments.each do |comment| %>
      <%# Müşteri rolündeki kullanıcılar dahili notları göremez! %>
      <% next if comment.is_internal_note? && current_user.customer? %>

      <div class="timeline-card <%= 'internal-note' if comment.is_internal_note? %>" style="border-radius: var(--radius-sm); padding: 1.15rem; border: 1px solid var(--border); box-shadow: var(--shadow-sm); <%= comment.is_internal_note? ? '' : (comment.author_role == 'agent' ? 'background: #f8fafc; border-left: 4px solid #4f46e5;' : 'background: white; border-left: 4px solid #10b981;') %>">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.825rem; color: var(--neutral-muted); margin-bottom: 0.65rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-weight: 700; color: var(--neutral-dark);">
              <% if comment.author_role == "agent" %>
                🛡️ <%= comment.author_name %> (Destek Temsilcisi)
              <% else %>
                👤 <%= comment.author_name %> (Müşteri)
              <% end %>
            </span>
            <% if comment.is_internal_note? %>
              <span class="internal-note-badge">🔒 Dahili Not (Müşteri Göremez)</span>
            <% end %>
          </div>
          <span><%= comment.created_at.strftime("%d.%m.%Y %H:%M") %></span>
        </div>
        <div style="font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; color: var(--neutral-text);">
          <%= comment.body %>
        </div>

        <!-- Yorum Dosya Ekleri -->
        <% if comment.attachments.attached? %>
          <div style="margin-top: 0.75rem; padding-top: 0.65rem; border-top: 1px dashed #cbd5e1;">
            <strong style="font-size: 0.75rem; color: #64748b;">📎 Ekli Dosyalar:</strong>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.35rem;">
              <% comment.attachments.each do |att| %>
                <a href="<%= rails_blob_path(att, disposition: 'attachment') %>" target="_blank" class="table-badge badge-info" style="text-decoration: none;">
                  📄 <%= att.filename %> (<%= number_to_human_size(att.byte_size) %>)
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Yanıt / Dahili Not Ekleme Formu -->
  <% unless @ticket.closed? %>
    <div style="margin-top: 2rem; padding-top: 1.75rem; border-top: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
        <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
          <%= current_user.staff? ? "Yanıt veya Dahili Not Yaz" : "Yanıtınızı İletin" %>
        </h3>

        <% if current_user.staff? && @canned_responses.any? %>
          <!-- Hazır Yanıt (Macro) Seçici -->
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <label style="font-size: 0.8rem; color: var(--neutral-muted); font-weight: 600;">Hazır Yanıt (Makro):</label>
            <select id="canned-select" class="form-select" style="font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: var(--radius-sm);" onchange="insertCannedResponse(this.value)">
              <option value="">Seçiniz...</option>
              <% @canned_responses.each do |cr| %>
                <option value="<%= cr.content %>"><%= cr.title %></option>
              <% end %>
            </select>
          </div>
        <% end %>
      </div>

      <%= form_with model: [@ticket, @new_comment], local: true, multipart: true do |f| %>
        <%= f.hidden_field :author_name, value: current_user.name %>
        <%= f.hidden_field :author_role, value: current_user.staff? ? "agent" : "customer" %>

        <% if current_user.staff? %>
          <div style="display: flex; gap: 1rem; margin-bottom: 0.85rem; font-size: 0.85rem; font-weight: 600;">
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; padding: 0.4rem 0.75rem; background: #eef2ff; border-radius: 6px; border: 1px solid #c7d2fe; color: #4338ca;">
              <%= f.radio_button :is_internal_note, false, checked: true, style: "accent-color: #4f46e5;" %>
              📢 Herkese Açık Yanıt (Müşteri görür)
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; padding: 0.4rem 0.75rem; background: #fffbeb; border-radius: 6px; border: 1px solid #fde68a; color: #b45309;">
              <%= f.radio_button :is_internal_note, true, style: "accent-color: #f59e0b;" %>
              🔒 Dahili Not (Sadece ekip görür)
            </label>
          </div>
        <% end %>

        <div class="form-group" style="margin-bottom: 0.85rem;">
          <%= f.text_area :body, id: "comment-textarea", placeholder: current_user.staff? ? "Yanıtınızı veya dahili notunuzu buraya yazın..." : "Destek ekibine iletilecek mesajınızı yazın...", class: "form-input", required: true, rows: 4, style: "font-size: 0.925rem;" %>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <%= f.label :attachments, "📎 Dosya Ekle:", style: "font-size: 0.8rem; color: #64748b; margin: 0; font-weight: 600;" %>
            <%= f.file_field :attachments, multiple: true, style: "font-size: 0.8rem;" %>
          </div>
          <%= f.submit "Mesajı Kaydet ve Gönder", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div style="margin-top: 1.5rem; padding: 1.15rem; background: #f8fafc; border-radius: var(--radius-sm); border: 1px dashed var(--border); text-align: center; color: var(--neutral-muted); font-size: 0.875rem;">
      🔒 Bu talep kapatılmıştır. Yeni yanıt eklemek için yukarıdaki butonlardan talebi yeniden açabilirsiniz.
    </div>
  <% end %>
</div>

<script>
  function insertCannedResponse(content) {
    if (!content) return;
    const textarea = document.getElementById('comment-textarea');
    if (textarea) {
      textarea.value = content;
      textarea.focus();
    }
  }
</script>
