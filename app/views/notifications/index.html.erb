<% content_for :title, "Bildirim Merkezi" %>

<div class="page-header">
  <div>
    <h1 class="page-title">🔔 Bildirim Merkezi</h1>
    <p class="page-subtitle">
      E-posta kirliliğine karşı <strong>tek merkezli anlık bildirim akışı</strong> ve okunma durumu.
    </p>
  </div>
  <% if @unread_count > 0 %>
    <div>
      <%= button_to "✓ Tümünü Okundu İşaretle (#{@unread_count})", mark_all_as_read_notifications_path, method: :post, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>

<div class="card" style="max-width: 840px; margin: 0 auto; padding: 1.5rem; box-shadow: var(--shadow-md);">
  <% if @notifications.empty? %>
    <div style="text-align: center; padding: 4rem 1rem; color: var(--neutral-muted);">
      <div style="font-size: 3rem; margin-bottom: 0.75rem;">🔔</div>
      <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--neutral-dark); margin-bottom: 0.25rem;">Henüz yeni bir bildiriminiz bulunmuyor</h3>
      <p style="font-size: 0.875rem;">Bilet atamaları, yeni müşteri yanıtları veya SLA uyarıları burada anlık olarak listelenecektir.</p>
    </div>
  <% else %>
    <div style="display: flex; flex-direction: column; gap: 0.85rem;">
      <% @notifications.each do |n| %>
        <div style="padding: 1.15rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid <%= n.read? ? 'var(--border)' : '#bbf7d0' %>; background: <%= n.read? ? '#ffffff' : '#f0fdf4' %>; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; transition: background 0.2s ease;">
          <div style="display: flex; gap: 0.85rem; align-items: flex-start;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: <%= n.read? ? '#f1f5f9' : '#dcfce7' %>; color: <%= n.read? ? '#64748b' : '#166534' %>; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; margin-top: 0.15rem;">
              <%= n.title.include?('Atandı') ? '👤' : (n.title.include?('SLA') ? '⏱️' : '💬') %>
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <% unless n.read? %>
                  <span style="font-size: 0.7rem; font-weight: 700; background: #22c55e; color: white; padding: 0.1rem 0.45rem; border-radius: 12px; text-transform: uppercase;">YENİ</span>
                <% end %>
                <strong style="color: var(--neutral-dark); font-size: 0.95rem;"><%= n.title %></strong>
                <span style="font-size: 0.75rem; color: var(--neutral-muted);">• <%= time_ago_in_words(n.created_at) %> önce</span>
              </div>
              <p style="font-size: 0.875rem; color: var(--neutral-text); line-height: 1.5; margin-bottom: 0.5rem;">
                <%= n.message %>
              </p>
              <% if n.notifiable.present? && n.notifiable.is_a?(Ticket) %>
                <%= link_to "Talebe Git (#PD-#{n.notifiable.ticket_number}) →", ticket_path(n.notifiable), style: "font-size: 0.825rem; font-weight: 700; color: var(--primary); text-decoration: none;" %>
              <% end %>
            </div>
          </div>
          <div>
            <% unless n.read? %>
              <%= button_to "Okundu", mark_as_read_notification_path(n), method: :patch, class: "btn btn-secondary btn-sm", style: "font-size: 0.75rem; padding: 0.25rem 0.55rem;" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
