<div class="page-header">
  <div>
    <h1 class="page-title">Bildirim Merkezi</h1>
    <p class="page-subtitle">
      E-posta kirliliğine karşı <strong>tek merkezli uygulama içi bildirimler</strong> ve anlık okunma durumu.
    </p>
  </div>
  <% if @unread_count > 0 %>
    <div>
      <%= button_to "✓ Tümünü Okundu İşaretle", mark_all_as_read_notifications_path, method: :post, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  <% if @notifications.empty? %>
    <div style="text-align: center; padding: 3rem; color: var(--neutral-muted);">
      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔔</div>
      <p style="font-weight: 600;">Henüz yeni bir bildiriminiz bulunmuyor.</p>
    </div>
  <% else %>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <% @notifications.each do |n| %>
        <div style="padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: <%= n.read? ? '#ffffff' : '#f0fdf4' %>; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <% unless n.read? %>
                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block;"></span>
              <% end %>
              <strong style="color: var(--neutral-dark);"><%= n.title %></strong>
              <span style="font-size: 0.75rem; color: var(--neutral-muted);"><%= time_ago_in_words(n.created_at) %> önce</span>
            </div>
            <p style="font-size: 0.875rem; color: var(--neutral-text); margin-bottom: 0.4rem;">
              <%= n.message %>
            </p>
            <% if n.notifiable.present? && n.notifiable.is_a?(Ticket) %>
              <%= link_to "Talebe Git (#PD-#{n.notifiable.ticket_number}) →", ticket_path(n.notifiable), style: "font-size: 0.8rem; font-weight: 600;" %>
            <% end %>
          </div>
          <div>
            <% unless n.read? %>
              <%= button_to "Okundu", mark_as_read_notification_path(n), method: :patch, class: "btn btn-sm", style: "border: 1px solid var(--border); font-size: 0.75rem;" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
