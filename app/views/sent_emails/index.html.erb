<div class="header-actions">
  <div>
    <h1 style="font-size: 26px; font-weight: 800; color: #1e293b; margin: 0 0 6px 0;">✉️ Giden E-posta Kutusu (Outbox & Email Logs)</h1>
    <p style="color: #64748b; margin: 0; font-size: 14px;">
      Sistem tarafından müşterilere ve destek personeline gönderilen gerçek e-posta bildirimleri ve teslimat kayıtları.
    </p>
  </div>
</div>

<div class="card" style="margin-top: 20px;">
  <% if @sent_emails.empty? %>
    <div style="text-align: center; padding: 48px; color: #64748b;">
      <div style="font-size: 40px; margin-bottom: 12px;">📭</div>
      <h3 style="margin: 0 0 6px 0; color: #1e293b;">Henüz Gönderilmiş E-posta Yok</h3>
      <p style="margin: 0;">Yeni bir destek talebi açıldığında veya yanıt verildiğinde otomatik e-postalar burada listelenecektir.</p>
    </div>
  <% else %>
    <table class="table" style="width: 100%;">
      <thead>
        <tr>
          <th>Tarih</th>
          <th>Alıcı E-posta</th>
          <th>Konu</th>
          <th>Tür</th>
          <th>Durum</th>
          <th>İşlem</th>
        </tr>
      </thead>
      <tbody>
        <% @sent_emails.each do |mail| %>
          <tr>
            <td style="font-size: 13px; color: #64748b; white-space: nowrap;">
              <%= mail.created_at.strftime("%d.%m.%Y %H:%M") %>
            </td>
            <td style="font-weight: 600; color: #1e293b;">
              <%= mail.to_email %>
            </td>
            <td>
              <%= mail.subject %>
            </td>
            <td>
              <span class="badge badge-info"><%= mail.mail_type %></span>
            </td>
            <td>
              <span class="badge badge-success">✓ <%= mail.status.upcase %></span>
            </td>
            <td>
              <%= link_to "Görüntüle", sent_email_path(mail), class: "btn btn-secondary", style: "padding: 4px 10px; font-size: 12px;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
