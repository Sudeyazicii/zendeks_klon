<% content_for :title, "E-posta Detayı: #{@sent_email.subject}" %>

<div style="margin-bottom: 1.25rem;">
  <%= link_to "← Giden E-posta Kutusuna Dön", sent_emails_path, class: "btn btn-secondary btn-sm" %>
</div>

<div class="card" style="max-width: 840px; margin: 0 auto; box-shadow: var(--shadow-md);">
  <div style="border-bottom: 1px solid var(--border); padding-bottom: 1.25rem; margin-bottom: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
      <div>
        <span class="table-badge badge-success" style="margin-bottom: 0.5rem; display: inline-block;">
          ✓ TESLİM EDİLDİ
        </span>
        <h1 style="font-size: 1.35rem; font-weight: 800; color: var(--neutral-dark); margin: 0.25rem 0 0.5rem 0;">
          <%= @sent_email.subject %>
        </h1>
      </div>
      <% if @sent_email.ticket_id.present? %>
        <%= link_to "İlgili Talebe Git (#PD-#{@sent_email.ticket&.ticket_number || @sent_email.ticket_id}) →", ticket_path(@sent_email.ticket_id), class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; margin-top: 1rem; padding: 0.85rem 1rem; background: #f8fafc; border-radius: var(--radius-sm); border: 1px solid var(--border); font-size: 0.85rem;">
      <div>
        <span style="color: var(--neutral-muted);">Alıcı Adresi:</span><br>
        <strong style="color: var(--neutral-dark);"><%= @sent_email.to_email %></strong>
      </div>
      <div>
        <span style="color: var(--neutral-muted);">Gönderim Zamanı:</span><br>
        <strong style="color: var(--neutral-dark);"><%= @sent_email.created_at.strftime("%d.%m.%Y %H:%M:%S") %></strong>
      </div>
      <div>
        <span style="color: var(--neutral-muted);">E-posta Tipi:</span><br>
        <strong style="color: var(--primary);"><%= @sent_email.mail_type %></strong>
      </div>
    </div>
  </div>

  <div>
    <h3 style="font-size: 0.8rem; font-weight: 700; color: var(--neutral-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;">
      ✉️ E-posta Gövdesi (Plain-Text / HTML Render):
    </h3>
    <div style="background: #ffffff; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1.5rem; font-family: inherit; font-size: 0.95rem; line-height: 1.7; color: var(--neutral-text); white-space: pre-wrap; box-shadow: inset 0 1px 3px rgba(0,0,0,0.02);">
<%= @sent_email.body %>
    </div>
  </div>
</div>
