<div style="margin-bottom: 20px;">
  <%= link_to "← E-posta Kutusuna Dön", sent_emails_path, class: "btn btn-secondary" %>
</div>

<div class="card">
  <div style="border-bottom: 1px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h2 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0;"><%= @sent_email.subject %></h2>
      <span class="badge badge-success">✓ <%= @sent_email.status.upcase %></span>
    </div>
    <div style="margin-top: 12px; font-size: 14px; color: #64748b; line-height: 1.6;">
      <div><strong>Alıcı:</strong> <%= @sent_email.to_email %></div>
      <div><strong>Tarih:</strong> <%= @sent_email.created_at.strftime("%d.%m.%Y %H:%M:%S") %></div>
      <div><strong>Bildirim Türü:</strong> <%= @sent_email.mail_type %></div>
      <% if @sent_email.ticket_id %>
        <div><strong>İlgili Bilet:</strong> <%= link_to "Bilet ##{@sent_email.ticket_id}", ticket_path(@sent_email.ticket_id) %></div>
      <% end %>
    </div>
  </div>

  <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 20px;">
    <h4 style="margin: 0 0 12px 0; font-size: 14px; color: #64748b; text-transform: uppercase;">E-posta Gövdesi:</h4>
    <pre style="white-space: pre-wrap; font-family: inherit; margin: 0; line-height: 1.6; color: #1e293b;"><%= @sent_email.body %></pre>
  </div>
</div>
