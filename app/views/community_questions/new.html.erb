<% content_for :title, "Yeni Topluluk Sorusu Sor" %>

<div style="max-width: 720px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <a href="<%= community_questions_path %>" style="font-size: 0.85rem; color: var(--neutral-muted);">
      ← Topluluk Sorularına Dön
    </a>
  </div>

  <div class="card">
    <h1 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 0.25rem; color: var(--neutral-dark);">
      Yeni Topluluk Sorusu Sor
    </h1>
    <p style="font-size: 0.875rem; color: var(--neutral-muted); margin-bottom: 1.5rem;">
      Topluluk üyelerinden ve uzmanlardan yardım alın. 24 saat içinde yanıtlanmayan sorular otomatik olarak destek talebine dönüştürülür.
    </p>

    <%= form_with model: @question, local: true do |f| %>
      <% if @question.errors.any? %>
        <div class="flash-alert">
          <strong>Hata oluştu:</strong>
          <ul style="margin-left: 1.25rem; margin-top: 0.35rem;">
            <% @question.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :author_name, "Adınız Soyadınız", class: "form-label" %>
          <%= f.text_field :author_name, placeholder: "Örn. Can Demir", class: "form-control", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :author_email, "E-posta Adresiniz", class: "form-label" %>
          <%= f.email_field :author_email, placeholder: "can@example.com", class: "form-control", required: true %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :category, "Kategori", class: "form-label" %>
        <%= f.select :category, [
          ["Genel Kullanım", "Genel"],
          ["API & Entegrasyon", "Entegrasyon"],
          ["Fatura & Abonelik", "Fatura"],
          ["Hesap & Güvenlik", "Güvenlik"],
          ["Özellik Talebi", "Özellik"]
        ], {}, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :title, "Soru Başlığı", class: "form-label" %>
        <%= f.text_field :title, placeholder: "Sorunuzu özetleyen kısa bir başlık...", class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :body, "Soru Detayı", class: "form-label" %>
        <%= f.text_area :body, placeholder: "Sorunuzu, denediğiniz yöntemleri ve aldığınız hataları detaylıca anlatın...", class: "form-control", required: true, rows: 6 %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
        <a href="<%= community_questions_path %>" class="btn btn-secondary">İptal</a>
        <%= f.submit "Soruyu Yayınla", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
