<% content_for :title, "Yeni Topluluk Sorusu Sor" %>

<div style="max-width: 760px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <a href="<%= community_questions_path %>" style="font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
      ← Topluluk Sorularına Dön
    </a>
  </div>

  <div class="card" style="padding: 2.25rem;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
        <span style="font-size: 1.35rem;">💬</span>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
          Yeni Topluluk Sorusu Sor
        </h1>
      </div>
      <p style="font-size: 0.875rem; color: var(--neutral-muted); margin: 0;">
        Topluluk üyelerinden ve uzmanlardan yardım alın. 24 saat içinde yanıtlanmayan sorular otomatik olarak destek talebine dönüştürülür.
      </p>
    </div>

    <!-- 24 Saat Otomasyon Bilgi Rozeti -->
    <div style="background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%); border: 1px solid #ddd6fe; border-left: 4px solid #8b5cf6; border-radius: var(--radius-sm); padding: 0.85rem 1.15rem; margin-bottom: 1.75rem; font-size: 0.85rem; color: #5b21b6;">
      🛡️ <strong>24 Saat Yanıtsızlık Güvencesi:</strong> Sorunuz 24 saat boyunca bir yanıta ulaşamazsa sistemimiz bunu otomatik algılayıp doğrudan yetkili bir destek çalışanına bilet olarak atar.
    </div>

    <%= form_with model: @question, local: true do |f| %>
      <% if @question.errors.any? %>
        <div class="flash-alert" style="margin-bottom: 1.75rem;">
          <strong>Hata oluştu:</strong>
          <ul style="margin-left: 1.25rem; margin-top: 0.35rem;">
            <% @question.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :author_name, "Adınız Soyadınız", class: "form-label" %>
          <%= f.text_field :author_name, placeholder: "Örn. Can Demir", class: "form-input form-control", required: true %>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :author_email, "E-posta Adresiniz", class: "form-label" %>
          <%= f.email_field :author_email, placeholder: "can@example.com", class: "form-input form-control", required: true %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :category, "Kategori", class: "form-label" %>
        <%= f.select :category, [
          ["Genel Kullanım", "Genel"],
          ["API & Entegrasyon", "Entegrasyon"],
          ["Fatura & Abonelik", "Fatura"],
          ["Hesap & Güvenlik", "Güvenlik"],
          ["Özellik Talebi", "Özellik"]
        ], {}, class: "form-select form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :title, "Soru Başlığı", class: "form-label" %>
        <%= f.text_field :title, placeholder: "Sorunuzu özetleyen kısa bir başlık...", class: "form-input form-control", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :body, "Soru Detayı", class: "form-label" %>
        <%= f.text_area :body, placeholder: "Sorunuzu, denediğiniz yöntemleri ve aldığınız hataları detaylıca anlatın...", class: "form-input form-control", required: true, rows: 6 %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border);">
        <a href="<%= community_questions_path %>" class="btn btn-secondary">İptal</a>
        <%= f.submit "Soruyu Yayınla", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
