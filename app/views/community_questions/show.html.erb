<% content_for :title, @question.title %>

<div style="margin-bottom: 1.25rem;">
  <a href="<%= community_questions_path %>" style="font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
    ← Topluluk Sorularına Dön
  </a>
</div>

<div class="card" style="padding: 1.75rem; margin-bottom: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 300px;">
      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.65rem; align-items: center; flex-wrap: wrap;">
        <span class="table-badge badge-info">
          🏷️ <%= @question.category %>
        </span>

        <% if @question.converted_to_ticket? %>
          <span class="table-badge badge-success">
            ✓ Destek Talebine Dönüştürüldü
          </span>
        <% elsif @question.answers_count.zero? %>
          <% elapsed = (Time.current - @question.created_at) / 3600.0 %>
          <span class="table-badge badge-warning">
            ⏱ Yanıtsız (<%= sprintf("%.1f", elapsed) %> sa geçti)
          </span>
        <% end %>
      </div>

      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); line-height: 1.35; margin-bottom: 0.5rem;">
        <%= @question.title %>
      </h1>

      <p style="font-size: 0.85rem; color: var(--neutral-muted); margin: 0;">
        Soran: <strong style="color: var(--neutral-text);"><%= @question.author_name %></strong> (<%= @question.author_email %>) • 
        Yayınlanma: <%= @question.created_at.strftime("%d.%m.%Y %H:%M") %>
      </p>
    </div>

    <div>
      <% if @question.converted_to_ticket? %>
        <a href="<%= ticket_path(@question.ticket) %>" class="btn btn-success btn-sm" style="padding: 0.45rem 0.85rem; font-weight: 700;">
          Destek Talebini Aç (#<%= @question.ticket.ticket_number %>) →
        </a>
      <% else %>
        <%= button_to "Bu Soruyu Destek Talebine Dönüştür", convert_to_ticket_community_question_path(@question), method: :post, class: "btn btn-primary btn-sm", style: "padding: 0.45rem 0.85rem; font-weight: 700;" %>
      <% end %>
    </div>
  </div>

  <% if @question.converted_to_ticket? %>
    <div style="margin-top: 1.25rem; padding: 1rem 1.25rem; background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 1px solid #a7f3d0; border-left: 4px solid #10b981; border-radius: var(--radius-sm); font-size: 0.9rem; color: #065f46;">
      🛡️ <strong>Otomasyon Bilgisi:</strong> Bu soru, 
      <strong><%= @question.converted_at.strftime("%d.%m.%Y %H:%M") %></strong> tarihinde 
      <a href="<%= ticket_path(@question.ticket) %>" style="color: #065f46; font-weight: 800; text-decoration: underline;">
        #<%= @question.ticket.ticket_number %>
      </a> 
      numaralı resmi destek talebine başarıyla aktarılmıştır.
    </div>
  <% end %>

  <div style="margin-top: 1.5rem; font-size: 0.975rem; line-height: 1.65; white-space: pre-wrap; padding-top: 1.25rem; border-top: 1px solid var(--border); color: var(--neutral-text);">
    <%= @question.body %>
  </div>
</div>

<!-- Yanıtlar Bölümü -->
<div class="card" style="padding: 1.75rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
    <h2 style="font-size: 1.2rem; font-weight: 800; margin: 0; color: var(--neutral-dark); display: flex; align-items: center; gap: 0.5rem;">
      <span>💬</span> Topluluk Yanıtları <span style="font-size: 0.9rem; color: var(--neutral-muted); font-weight: 600;">(<%= @answers.count %>)</span>
    </h2>
  </div>

  <div class="timeline" style="margin: 0; display: flex; flex-direction: column; gap: 1rem;">
    <% if @answers.any? %>
      <% @answers.each do |ans| %>
        <div class="timeline-item" style="border-radius: var(--radius-sm); padding: 1.25rem; border: 1px solid var(--border); box-shadow: var(--shadow-sm); <%= ans.is_solution? ? 'background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid #86efac; border-left: 4px solid #10b981;' : 'background: white; border-left: 4px solid #cbd5e1;' %>">
          <div class="timeline-meta" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="timeline-author" style="font-size: 0.9rem;">💬 <%= ans.author_name %></span>
              <% if ans.is_solution? %>
                <span class="table-badge badge-success" style="font-size: 0.75rem;">
                  ✓ Kabul Edilen Doğru Çözüm
                </span>
              <% end %>
            </div>
            <span style="font-size: 0.8rem; color: var(--neutral-muted);"><%= ans.created_at.strftime("%d.%m.%Y %H:%M") %></span>
          </div>

          <div style="font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; margin-bottom: 0.85rem; color: var(--neutral-text);">
            <%= ans.body %>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 0.5rem; align-items: center; border-top: 1px solid <%= ans.is_solution? ? '#bbf7d0' : 'var(--border)' %>; padding-top: 0.65rem;">
            <!-- Faydalı Oy (Upvote) Butonu -->
            <%= button_to "👍 Faydalı Buldum (#{ans.upvotes_count})", upvote_community_question_community_answer_path(@question, ans), method: :post, class: "btn btn-sm btn-secondary", style: "font-size: 0.775rem; padding: 0.25rem 0.65rem; border-radius: 4px;" %>

            <!-- Doğru Çözüm Olarak İşaretleme Butonu -->
            <% if current_user.staff? && !ans.is_solution? %>
              <%= button_to "✓ Çözüm Olarak İşaretle", mark_solution_community_question_community_answer_path(@question, ans), method: :post, class: "btn btn-sm btn-success", style: "font-size: 0.775rem; padding: 0.25rem 0.65rem; border-radius: 4px;" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div style="padding: 2.5rem; text-align: center; color: var(--neutral-muted); font-size: 0.925rem; background: #f8fafc; border-radius: var(--radius-sm); border: 1px dashed var(--border);">
        <div style="font-size: 1.5rem; margin-bottom: 0.35rem;">💬</div>
        Henüz bir yanıt verilmedi. İlk yanıtı siz yazabilirsiniz. 
        <br><small style="color: #64748b; font-size: 0.8rem;">(24 saat boyunca yanıt gelmezse sistem bu soruyu otomatik olarak destek talebine çevirecektir.)</small>
      </div>
    <% end %>
  </div>

  <!-- Yanıt Ekle Formu -->
  <div style="margin-top: 2rem; padding-top: 1.75rem; border-top: 1px solid var(--border);">
    <h3 style="font-size: 1.05rem; font-weight: 800; margin-bottom: 1rem; color: var(--neutral-dark);">
      Yanıtını Paylaş
    </h3>

    <%= form_with model: [@question, @new_answer], local: true do |f| %>
      <div class="form-group">
        <%= f.label :author_name, "Adınız Soyadınız", class: "form-label" %>
        <%= f.text_field :author_name, placeholder: "Örn. Zeynep Kaya", class: "form-input form-control", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :body, "Yanıtınız", class: "form-label" %>
        <%= f.text_area :body, placeholder: "Topluluk sorusuna çözüm veya önerinizi yazın...", class: "form-input form-control", required: true, rows: 4 %>
      </div>

      <div style="display: flex; justify-content: flex-end;">
        <%= f.submit "Yanıtı Gönder", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
