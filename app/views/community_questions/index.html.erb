<% content_for :title, "Topluluk Forumu Soruları" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Topluluk Forumu Soruları</h1>
    <p class="page-subtitle">Kullanıcı topluluk soruları ve 24 saat otomatik destek talebi dönüşümü</p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <%= button_to "⚡ 24 Saat Otomatik Dönüşümü Çalıştır", trigger_auto_convert_community_questions_path, method: :post, class: "btn btn-warning" %>
    <a href="<%= new_community_question_path %>" class="btn btn-primary">+ Yeni Soru Sor</a>
  </div>
</div>

<!-- 100+ Puan Farkı Vurgu Kutusu (G2 Çözümü) -->
<div class="feature-callout">
  <div class="feature-callout-text">
    <h3>💡 100+ Puan Özelliği: 24 Saat Yanıtsız Soru Otomasyonu (G2 İnceleme Çözümü)</h3>
    <p>
      Zendesk G2 kullanıcı yorumlarında belirtilen "forumlarda cevapsız kalan soruların bilete dönüştürülememesi" eksikliği giderildi: 
      Toplulukta 24 saat boyunca yanıt almayan her soru, sistem tarafından <strong>otomatik olarak yüksek öncelikli destek talebine</strong> dönüştürülür.
    </p>
  </div>
  <div>
    <span class="badge" style="background-color: #312e81; color: white; padding: 0.5rem 0.85rem; font-size: 0.85rem;">
      Dönüştürülen: <%= @converted_count %> Soru
    </span>
  </div>
</div>

<div class="card">
  <div class="filter-bar">
    <div class="filter-tabs">
      <a href="<%= community_questions_path %>" class="filter-tab <%= 'active' if @filter.blank? %>">
        Tüm Sorular (<%= @total_count %>)
      </a>
      <a href="<%= community_questions_path(filter: 'unanswered') %>" class="filter-tab <%= 'active' if @filter == 'unanswered' %>">
        Cevapsız (<%= @unanswered_count %>)
      </a>
      <a href="<%= community_questions_path(filter: 'answered') %>" class="filter-tab <%= 'active' if @filter == 'answered' %>">
        Cevaplanan (<%= @total_count - @unanswered_count %>)
      </a>
      <a href="<%= community_questions_path(filter: 'converted') %>" class="filter-tab <%= 'active' if @filter == 'converted' %>">
        Destek Talebine Dönüştürülenler (<%= @converted_count %>)
      </a>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% if @questions.any? %>
      <% @questions.each do |q| %>
        <div style="border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; background: white; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
              <span class="badge" style="background-color: #e2e8f0; color: #334155;">
                <%= q.category %>
              </span>

              <% if q.converted_to_ticket? %>
                <span class="badge" style="background-color: #d1fae5; color: #065f46; font-weight: 700;">
                  ✓ Destek Talebine Dönüştürüldü (<a href="<%= ticket_path(q.ticket) %>" style="color: #065f46; text-decoration: underline;">#<%= q.ticket.ticket_number %></a>)
                </span>
              <% elsif q.answers_count.zero? %>
                <% elapsed_hours = (Time.current - q.created_at) / 3600.0 %>
                <% if elapsed_hours >= 24 %>
                  <span class="badge badge-breached">
                    ⚠️ 24 Saat Doldu (Dönüşüme Hazır)
                  </span>
                <% else %>
                  <span class="badge" style="background-color: #fef3c7; color: #92400e;">
                    ⏱ Yanıt Bekliyor (<%= sprintf("%.1f", 24 - elapsed_hours) %> sa kaldı)
                  </span>
                <% end %>
              <% else %>
                <span class="badge badge-solved">
                  ✓ <%= q.answers_count %> Yanıt Mevcut
                </span>
              <% end %>
            </div>

            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.35rem;">
              <a href="<%= community_question_path(q) %>" style="color: var(--neutral-dark);">
                <%= q.title %>
              </a>
            </h3>

            <p style="font-size: 0.875rem; color: var(--neutral-muted); margin-bottom: 0.5rem;">
              <%= truncate(q.body, length: 150) %>
            </p>

            <div style="font-size: 0.8rem; color: var(--neutral-muted);">
              Soran: <strong><%= q.author_name %></strong> • 
              Oluşturulma: <%= q.created_at.strftime("%d.%m.%Y %H:%M") %>
              <% if q.converted_at.present? %>
                • Dönüştürülme: <%= q.converted_at.strftime("%d.%m.%Y %H:%M") %>
              <% end %>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-end;">
            <a href="<%= community_question_path(q) %>" class="btn btn-secondary btn-sm">
              Görüntüle & Yanıtla (<%= q.answers_count %>)
            </a>

            <% unless q.converted_to_ticket? %>
              <%= button_to "Talebe Dönüştür", convert_to_ticket_community_question_path(q), method: :post, class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 2.5rem; color: var(--neutral-muted);">
        Bu filtreye ait soru bulunamadı.
      </div>
    <% end %>
  </div>
</div>
