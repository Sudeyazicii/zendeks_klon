<% content_for :title, "Topluluk Forumu Soruları" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Topluluk Forumu Soruları</h1>
    <p class="page-subtitle">Kullanıcı topluluk soruları ve 24 saat otomatik destek talebi dönüşümü</p>
  </div>
  <div style="display: flex; gap: 0.65rem; align-items: center;">
    <%= button_to "⚡ 24 Saat Otomatik Dönüşümü Çalıştır", trigger_auto_convert_community_questions_path, method: :post, class: "btn btn-primary" %>
    <a href="<%= new_community_question_path %>" class="btn btn-secondary">+ Yeni Soru Sor</a>
  </div>
</div>

<!-- 24 Saat Otomasyonu Metrik Paneli -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 1.5rem;">
  <div class="stat-card" style="border-top: 3px solid #f59e0b;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">⏳</div>
    <div class="stat-value" style="color: #d97706;"><%= @eligible_count %></div>
    <div class="stat-label">
      Şu Anda Dönüşüme Uygun
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        (Cevapsız & >24 saat geçmiş)
      </div>
    </div>
  </div>

  <div class="stat-card" style="border-top: 3px solid var(--primary);">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">🔄</div>
    <div class="stat-value" style="color: var(--primary);"><%= @last_converted_count %></div>
    <div class="stat-label">
      Son Çalıştırmada Dönüştürülen
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        (Son döngüde açılan talep)
      </div>
    </div>
  </div>

  <div class="stat-card" style="border-top: 3px solid var(--success);">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">✅</div>
    <div class="stat-value" style="color: var(--success);"><%= @converted_count %></div>
    <div class="stat-label">
      Bugüne Kadar Toplam Dönüştürülen
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        (Sistem genelinde toplam başarı)
      </div>
    </div>
  </div>

  <div class="stat-card" style="border-top: 3px solid var(--neutral-dark);">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">⏱️</div>
    <div class="stat-value" style="font-size: 1.25rem; font-weight: 800; color: var(--neutral-dark); margin-top: 0.6rem;">
      <%= @last_run_at ? @last_run_at.strftime("%d.%m %H:%M") : "Henüz Yok" %>
    </div>
    <div class="stat-label" style="margin-top: 0.4rem;">
      Son Çalışma Zamanı & Sonuç
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        Durum: <strong><%= @last_status&.upcase || "HAZIR" %></strong>
      </div>
    </div>
  </div>
</div>

<!-- 100+ Puan Farkı Vurgu Kutusu (G2 Çözümü) -->
<div class="feature-callout" style="margin-bottom: 1.5rem;">
  <div class="feature-callout-text">
    <h3>💡 100+ Puan Özelliği: 24 Saat Yanıtsız Soru Otomasyonu (G2 İnceleme Çözümü)</h3>
    <p>
      Destek forumlarında sıkça karşılaşılan "cevapsız kalan soruların unutulması ve kaybolması" sorununa kesin çözüm: 
      Toplulukta 24 saat boyunca yanıt almayan her soru, sistem tarafından <strong>otomatik olarak yüksek öncelikli destek talebine</strong> dönüştürülür.
    </p>
  </div>
</div>

<div class="card" style="box-shadow: var(--shadow-sm);">
  <!-- Filtre ve Arama Çubuğu -->
  <div class="filter-bar" style="flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.25rem;">
    <div class="filter-tabs" style="margin-bottom: 0; flex-wrap: wrap;">
      <a href="<%= community_questions_path %>" class="filter-tab <%= 'active' if @filter.blank? %>">
        Tüm Sorular (<%= @total_count %>)
      </a>
      <a href="<%= community_questions_path(filter: 'unanswered') %>" class="filter-tab <%= 'active' if @filter == 'unanswered' %>">
        Cevapsız (<%= @unanswered_count %>)
      </a>
      <a href="<%= community_questions_path(filter: 'answered') %>" class="filter-tab <%= 'active' if @filter == 'answered' %>">
        Cevaplanan (<%= @total_count - @unanswered_count %>)
      </a>
      <a href="<%= community_questions_path(filter: 'converted') %>" class="filter-tab <%= 'active' if @filter == 'converted' %>">
        Destek Talebine Dönüştürülenler (<%= @converted_count %>)
      </a>
    </div>

    <%= form_with url: community_questions_path, method: :get, local: true, style: "display: flex; gap: 0.5rem; align-items: center;" do %>
      <%= hidden_field_tag :filter, @filter if @filter.present? %>
      <%= text_field_tag :query, params[:query], placeholder: "🔍 Sorularda ara...", class: "form-input", style: "padding: 0.4rem 0.65rem; font-size: 0.85rem; width: 200px;" %>
      <%= submit_tag "Ara", class: "btn btn-secondary btn-sm" %>
      <% if params[:query].present? %>
        <%= link_to "Temizle", community_questions_path(filter: @filter), class: "btn btn-secondary btn-sm" %>
      <% end %>
    <% end %>
  </div>

  <!-- Soru Listesi -->
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% if @questions.any? %>
      <% @questions.each do |q| %>
        <div style="border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; background: white; display: flex; justify-content: space-between; align-items: flex-start; gap: 1.25rem; flex-wrap: wrap; transition: transform 0.15s ease, box-shadow 0.15s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--shadow-md)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.45rem; flex-wrap: wrap;">
              <span class="table-badge badge-info" style="font-size: 0.75rem;">
                🏷️ <%= q.category %>
              </span>

              <% if q.converted_to_ticket? %>
                <span class="table-badge badge-success" style="font-size: 0.75rem;">
                  ✓ Destek Talebine Dönüştürüldü (<a href="<%= ticket_path(q.ticket) %>" style="color: #065f46; text-decoration: underline; font-weight: 700;">#<%= q.ticket.ticket_number %></a>)
                </span>
              <% elsif q.answers_count.zero? %>
                <% elapsed_hours = (Time.current - q.created_at) / 3600.0 %>
                <% if elapsed_hours >= 24 %>
                  <span class="table-badge badge-danger" style="font-size: 0.75rem;">
                    ⚠️ 24 Saat Doldu (Dönüşüme Hazır)
                  </span>
                <% else %>
                  <span class="table-badge badge-warning" style="font-size: 0.75rem;">
                    ⏱ Yanıt Bekliyor (<%= sprintf("%.1f", 24 - elapsed_hours) %> sa kaldı)
                  </span>
                <% end %>
              <% else %>
                <span class="table-badge badge-success" style="font-size: 0.75rem;">
                  ✓ <%= q.answers_count %> Yanıt Mevcut
                </span>
              <% end %>
            </div>

            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.4rem; line-height: 1.4;">
              <a href="<%= community_question_path(q) %>" style="color: var(--neutral-dark); text-decoration: none;">
                <%= q.title %>
              </a>
            </h3>

            <p style="font-size: 0.875rem; color: var(--neutral-muted); margin-bottom: 0.65rem; line-height: 1.5;">
              <%= truncate(q.body, length: 150) %>
            </p>

            <div style="font-size: 0.8rem; color: var(--neutral-muted);">
              Soran: <strong style="color: var(--neutral-dark);"><%= q.author_name %></strong> • 
              Oluşturulma: <%= q.created_at.strftime("%d.%m.%Y %H:%M") %>
              <% if q.converted_at.present? %>
                • Dönüştürülme: <%= q.converted_at.strftime("%d.%m.%Y %H:%M") %>
              <% end %>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-end; justify-content: center; align-self: center;">
            <a href="<%= community_question_path(q) %>" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; white-space: nowrap;">
              💬 İncele & Yanıtla (<%= q.answers_count %>)
            </a>

            <% unless q.converted_to_ticket? %>
              <%= button_to "⚡ Talebe Dönüştür", convert_to_ticket_community_question_path(q), method: :post, class: "btn btn-primary btn-sm", style: "font-size: 0.8rem; white-space: nowrap;" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 3rem; color: var(--neutral-muted);">
        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💬</div>
        Bu filtreye ait forum sorusu bulunamadı.
      </div>
    <% end %>
  </div>
</div>
