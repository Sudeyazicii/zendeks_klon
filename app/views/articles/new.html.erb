<% content_for :title, "Yeni Bilgi Bankası Makalesi" %>

<div style="max-width: 780px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <%= link_to "← Bilgi Bankasına Dön", articles_path, style: "font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;" %>
  </div>

  <div class="card" style="padding: 2.25rem;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
        <span style="font-size: 1.35rem;">📚</span>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
          Yeni Bilgi Bankası Makalesi Yayınla
        </h1>
      </div>
      <p style="font-size: 0.875rem; color: var(--neutral-muted); margin: 0;">
        Müşterilerin kendi kendine çözüme ulaşmasını sağlamak için kapsamlı rehberler ve SSS içerikleri hazırlayın.
      </p>
    </div>

    <%= form_with model: @article, local: true do |f| %>
      <% if @article.errors.any? %>
        <div class="flash-alert" style="margin-bottom: 1.75rem;">
          <%= @article.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <%= f.label :title, "Makale Başlığı", class: "form-label" %>
        <%= f.text_field :title, class: "form-input", placeholder: "Örn: e-Fatura GİB Onay Süreçleri ve İtiraz Rehberi", required: true, style: "font-size: 1.05rem; font-weight: 600; padding: 0.75rem 1rem;" %>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <%= f.label :category, "Kategori", class: "form-label" %>
        <%= f.select :category, ["Fatura & Ödeme", "Genel Destek", "Teknik Hata", "Entegrasyon & API", "Hesap & Güvenlik"], {}, class: "form-select", style: "width: 100%;" %>
      </div>

      <div class="form-group" style="margin-bottom: 1.75rem;">
        <%= f.label :body, "Makale İçeriği (Markdown veya Düz Metin)", class: "form-label" %>
        <%= f.text_area :body, rows: 12, class: "form-input", placeholder: "Makale içeriğini detaylı ve anlaşılır biçimde yazın...", required: true, style: "font-size: 0.95rem; line-height: 1.65; padding: 1rem;" %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border);">
        <%= link_to "İptal", articles_path, class: "btn btn-secondary" %>
        <%= f.submit "Makaleyi Yayınla", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
