<% content_for :title, @article.title %>

<div style="margin-bottom: 1.25rem;">
  <%= link_to "← Bilgi Bankasına Dön", articles_path, class: "btn btn-secondary btn-sm" %>
</div>

<div class="card" style="max-width: 860px; margin: 0 auto; padding: 2.25rem; box-shadow: var(--shadow-md);">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
    <span class="table-badge badge-info" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">
      🏷️ <%= @article.category %>
    </span>
    <span style="font-size: 0.8rem; color: var(--neutral-muted);">
      👁️ <%= @article.views_count %> kez okundu • Yayınlanma: <%= @article.created_at.strftime("%d.%m.%Y") %>
    </span>
  </div>

  <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--neutral-dark); margin-bottom: 1.5rem; line-height: 1.35; letter-spacing: -0.02em;">
    <%= @article.title %>
  </h1>

  <div style="font-size: 1.05rem; line-height: 1.85; color: var(--neutral-text); white-space: pre-wrap; border-top: 1px solid var(--border); padding-top: 1.75rem; margin-bottom: 2.25rem; letter-spacing: -0.01em;">
<%= @article.body %>
  </div>

  <!-- Yardımcı Oldu mu? / Geri Bildirim -->
  <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
    <span style="font-size: 0.875rem; color: var(--neutral-text); font-weight: 600;">
      💡 Bu makale sorunuzu çözmenize yardımcı oldu mu?
    </span>
    <div style="display: flex; gap: 0.5rem;">
      <button type="button" class="btn btn-secondary btn-sm" onclick="this.innerHTML='👍 Teşekkürler!'; this.style.color='#10b981';">
        👍 Evet, faydalı
      </button>
      <button type="button" class="btn btn-secondary btn-sm" onclick="this.innerHTML='Destek talebi açabilirsiniz'; this.style.color='#64748b';">
        👎 Hayır
      </button>
    </div>
  </div>

  <% if current_user.staff? %>
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border); padding-top: 1.25rem;">
      <%= link_to "✏️ Makaleyi Düzenle", edit_article_path(@article), class: "btn btn-secondary btn-sm" %>
      <%= button_to "🗑️ Makaleyi Sil", article_path(@article), method: :delete, data: { turbo_confirm: "Silmek istediğinize emin misiniz?" }, class: "btn btn-danger btn-sm" %>
    </div>
  <% end %>
</div>
