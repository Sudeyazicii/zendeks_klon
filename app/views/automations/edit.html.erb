<div class="page-header">
  <div>
    <h1 class="page-title">Otomasyon Kuralını Düzenle</h1>
    <p class="page-subtitle">
      <strong>"<%= @rule.name %>"</strong> kuralının koşul ve aksiyonlarını güncelleyin.
    </p>
  </div>
  <div>
    <%= link_to "← İptal", automations_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card" style="max-width: 820px; margin: 0 auto; padding: 2.25rem;">
  <%= form_with url: automation_path(@rule), method: :patch, local: true do |f| %>
    <!-- Kural Temel Bilgileri -->
    <div style="margin-bottom: 2rem;">
      <h3 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--neutral-muted); margin-bottom: 1rem;">
        ⚡ Temel Kural Ayarları
      </h3>
      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label">Kural Adı</label>
        <input type="text" name="rule[name]" value="<%= @rule.name %>" class="form-input" required />
      </div>

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label">Açıklama</label>
        <input type="text" name="rule[description]" value="<%= @rule.description %>" class="form-input" />
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label">Tetikleyici Türü</label>
        <select name="rule[trigger_type]" class="form-select">
          <option value="event" <%= 'selected' if @rule.trigger_type == 'event' %>>⚡ Olay Tabanlı</option>
          <option value="time_based" <%= 'selected' if @rule.trigger_type == 'time_based' %>>⏱️ Zaman Tabanlı</option>
        </select>
      </div>
    </div>

    <!-- 1. Koşul Bloğu (IF) -->
    <div style="background: #f8fafc; border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius-md); padding: 1.35rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
        <span class="table-badge badge-primary" style="font-size: 0.75rem;">1. IF / EĞER</span>
        <h3 style="font-size: 1rem; font-weight: 800; color: var(--primary); margin: 0;">
          Eşleşme Koşulları
        </h3>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.825rem;">Hedef Talep Durumu</label>
          <select name="condition_status" class="form-select" style="font-size: 0.85rem;">
            <option value="">(Tüm Durumlar)</option>
            <option value="new" <%= 'selected' if @conds['status'] == 'new' %>>Yeni (NEW)</option>
            <option value="open" <%= 'selected' if @conds['status'] == 'open' %>>Açık (OPEN)</option>
            <option value="pending" <%= 'selected' if @conds['status'] == 'pending' %>>Beklemede (PENDING)</option>
            <option value="breached" <%= 'selected' if @conds['status'] == 'breached' %>>SLA İhlali Olanlar</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.825rem;">Hedef Öncelik</label>
          <select name="condition_priority" class="form-select" style="font-size: 0.85rem;">
            <option value="">(Tüm Öncelikler)</option>
            <option value="urgent" <%= 'selected' if @conds['priority'] == 'urgent' %>>Acil (URGENT)</option>
            <option value="high" <%= 'selected' if @conds['priority'] == 'high' %>>Yüksek (HIGH)</option>
            <option value="medium" <%= 'selected' if @conds['priority'] == 'medium' %>>Normal (MEDIUM)</option>
            <option value="low" <%= 'selected' if @conds['priority'] == 'low' %>>Düşük (LOW)</option>
          </select>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem; font-weight: 600; color: var(--neutral-text);">
          <input type="checkbox" name="condition_unassigned" value="1" <%= 'checked' if @conds['unassigned'] %> style="width: 17px; height: 17px; accent-color: var(--primary);" />
          Sadece henüz bir çalışana atanmamış talepleri hedefle
        </label>
      </div>
    </div>

    <!-- 2. Eylem Bloğu (THEN) -->
    <div style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid #bbf7d0; border-left: 4px solid #10b981; border-radius: var(--radius-md); padding: 1.35rem; margin-bottom: 1.75rem; box-shadow: var(--shadow-sm);">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
        <span class="table-badge badge-success" style="font-size: 0.75rem;">2. THEN / O ZAMAN</span>
        <h3 style="font-size: 1rem; font-weight: 800; color: #166534; margin: 0;">
          Planlanan Eylemler
        </h3>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.825rem; color: #166534;">Yeni Öncelik Ata</label>
          <select name="action_priority" class="form-select" style="font-size: 0.85rem;">
            <option value="">(Değiştirme)</option>
            <option value="urgent" <%= 'selected' if @acts['set_priority'] == 'urgent' %>>Acil (URGENT)</option>
            <option value="high" <%= 'selected' if @acts['set_priority'] == 'high' %>>Yüksek (HIGH)</option>
            <option value="medium" <%= 'selected' if @acts['set_priority'] == 'medium' %>>Normal (MEDIUM)</option>
            <option value="low" <%= 'selected' if @acts['set_priority'] == 'low' %>>Düşük (LOW)</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.825rem; color: #166534;">Çalışana Ata</label>
          <select name="action_assign_to" class="form-select" style="font-size: 0.85rem;">
            <option value="">(Değiştirme)</option>
            <% @agents.each do |agent| %>
              <option value="<%= agent.id %>" <%= 'selected' if @acts['assign_to_user_id'] == agent.id.to_s || @acts['assign_to_user_id'] == agent.id %>><%= agent.name %> (<%= agent.department %>)</option>
            <% end %>
          </select>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" style="font-size: 0.825rem; color: #166534;">Etiket Ekle</label>
        <input type="text" name="action_tag" value="<%= @acts['add_tag'] %>" class="form-input" placeholder="Örn: eskale_edildi" style="font-size: 0.85rem;" />
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 1.5rem; padding: 0.85rem 1rem; background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-sm);">
      <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.875rem; font-weight: 600; color: var(--neutral-dark); margin: 0;">
        <input type="checkbox" name="rule[active]" value="1" <%= 'checked' if @rule.active? %> style="width: 18px; height: 18px; accent-color: var(--primary);" />
        Bu kural etkin olsun
      </label>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border);">
      <%= link_to "İptal", automations_path, class: "btn btn-secondary" %>
      <%= f.submit "Kuralı Güncelle ve Önizle", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
