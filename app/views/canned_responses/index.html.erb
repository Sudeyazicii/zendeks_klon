<% content_for :title, "Hazır Yanıtlar (Makrolar)" %>

<div class="page-header">
  <div>
    <h1 class="page-title">📋 Hazır Yanıtlar (Makrolar & Canned Responses)</h1>
    <p class="page-subtitle">Destek temsilcilerinin bilet yanıtlarken tek tıkla uygulayabileceği kurumsal şablonlar</p>
  </div>
  <div>
    <%= link_to "+ Yeni Hazır Yanıt Ekle", new_canned_response_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="card" style="box-shadow: var(--shadow-sm);">
  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Başlık</th>
          <th>Kategori</th>
          <th>İçerik Şablonu</th>
          <th>Oluşturan</th>
          <th>Tarih</th>
          <th style="text-align: right;">İşlemler</th>
        </tr>
      </thead>
      <tbody>
        <% if @canned_responses.empty? %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 3.5rem 1rem; color: var(--neutral-muted);">
              <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📋</div>
              Henüz tanımlı bir hazır yanıt şablonu bulunmuyor. Yeni bir tane ekleyerek temsilcilerin hızını artırabilirsiniz.
            </td>
          </tr>
        <% else %>
          <% @canned_responses.each do |cr| %>
            <tr>
              <td>
                <strong style="color: var(--neutral-dark); font-size: 0.9rem;"><%= cr.title %></strong>
              </td>
              <td>
                <span class="table-badge badge-info"><%= cr.category %></span>
              </td>
              <td style="max-width: 420px; font-size: 0.85rem; color: #475569; line-height: 1.5;">
                <%= truncate(cr.content, length: 110) %>
              </td>
              <td style="font-size: 0.825rem; color: var(--neutral-muted);">
                <%= cr.created_by&.name || "Sistem" %>
              </td>
              <td style="font-size: 0.8rem; color: var(--neutral-muted);">
                <%= cr.created_at.strftime("%d.%m.%Y") %>
              </td>
              <td style="text-align: right;">
                <div style="display: flex; gap: 0.4rem; justify-content: flex-end;">
                  <%= link_to "Düzenle", edit_canned_response_path(cr), class: "btn btn-secondary btn-sm" %>
                  <%= button_to "Sil", canned_response_path(cr), method: :delete, data: { turbo_confirm: "'#{cr.title}' hazır yanıtını silmek istediğinize emin misiniz?" }, class: "btn btn-danger btn-sm", style: "font-size: 0.75rem; padding: 0.25rem 0.55rem;" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
