<% content_for :title, "Hazır Yanıtı Düzenle" %>

<div style="max-width: 720px; margin: 0 auto;">
  <div style="margin-bottom: 1.25rem;">
    <%= link_to "← Hazır Yanıtlara Dön", canned_responses_path, style: "font-size: 0.85rem; color: var(--neutral-muted); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;" %>
  </div>

  <div class="card" style="padding: 2.25rem;">
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
        <span style="font-size: 1.35rem;">✏️</span>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--neutral-dark); margin: 0;">
          Hazır Yanıtı Düzenle
        </h1>
      </div>
      <p style="font-size: 0.875rem; color: var(--neutral-muted); margin: 0;">
        "<%= @canned_response.title %>" makro şablonunu güncelleyin.
      </p>
    </div>

    <%= form_with model: @canned_response, local: true do |f| %>
      <% if @canned_response.errors.any? %>
        <div class="flash-alert" style="margin-bottom: 1.75rem;">
          <strong>Hata oluştu:</strong>
          <ul style="margin-left: 1.25rem; margin-top: 0.35rem;">
            <% @canned_response.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <%= f.label :title, "Şablon Başlığı", class: "form-label" %>
        <%= f.text_field :title, class: "form-input", required: true %>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <%= f.label :category, "Kategori", class: "form-label" %>
        <%= f.select :category, Ticket::CATEGORIES, {}, class: "form-select" %>
      </div>

      <div class="form-group" style="margin-bottom: 1.75rem;">
        <%= f.label :content, "Şablon Metni / Yanıt İçeriği", class: "form-label" %>
        <%= f.text_area :content, class: "form-input", rows: 7, required: true, style: "font-size: 0.925rem; line-height: 1.6;" %>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; padding-top: 1.25rem; border-top: 1px solid var(--border);">
        <%= link_to "İptal", canned_responses_path, class: "btn btn-secondary" %>
        <%= f.submit "Değişiklikleri Kaydet", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
