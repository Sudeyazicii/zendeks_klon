<% content_for :title, "Raporlar & Performans Analizi" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Raporlar & Performans Analizi</h1>
    <p class="page-subtitle">
      Destek operasyonları için en kritik 6 performans metriği, çalışan iş yükü dağılımı ve CSV dışa aktarımı.
    </p>
  </div>
  <div>
    <%= link_to "📥 CSV Olarak İndir", export_csv_reports_path, class: "btn btn-secondary" %>
  </div>
</div>

<!-- Tarih Aralığı Filtresi -->
<div class="card" style="padding: 1rem 1.25rem; margin-bottom: 1.5rem; background: #ffffff; border: 1px solid var(--border);">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.6rem;">
      <span style="font-size: 1.25rem;">📅</span>
      <div>
        <strong style="color: var(--neutral-dark); font-size: 0.925rem;">Tarih Aralığı Filtresi</strong>
        <p style="font-size: 0.775rem; color: var(--neutral-muted); margin: 0;">Özel tarih aralığındaki bilet performansını inceleyin</p>
      </div>
    </div>

    <%= form_with url: reports_path, method: :get, local: true, html: { style: "display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;" } do %>
      <div style="display: flex; align-items: center; gap: 0.4rem;">
        <label style="font-size: 0.8rem; font-weight: 600; color: var(--neutral-muted); margin: 0;">Başlangıç:</label>
        <input type="date" name="start_date" value="<%= @start_date %>" class="form-input" style="width: auto; min-width: 140px; padding: 0.35rem 0.6rem; font-size: 0.825rem; background: white;">
      </div>

      <div style="display: flex; align-items: center; gap: 0.4rem;">
        <label style="font-size: 0.8rem; font-weight: 600; color: var(--neutral-muted); margin: 0;">Bitiş:</label>
        <input type="date" name="end_date" value="<%= @end_date %>" class="form-input" style="width: auto; min-width: 140px; padding: 0.35rem 0.6rem; font-size: 0.825rem; background: white;">
      </div>

      <div style="display: flex; gap: 0.35rem; align-items: center;">
        <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.42rem 0.85rem;">Filtrele</button>
        <% if @date_filter_active %>
          <%= link_to "✕ Temizle", reports_path, class: "btn btn-secondary btn-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if @date_filter_active %>
    <div style="margin-top: 0.65rem; padding-top: 0.65rem; border-top: 1px dashed var(--border); font-size: 0.8rem; color: var(--primary); font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
      <span>📊</span> Aktif Filtreli Dönem: <strong><%= @start_date&.strftime("%d.%m.%Y") || "İlk Kayıt" %></strong> – <strong><%= @end_date&.strftime("%d.%m.%Y") || "Bugün" %></strong>
    </div>
  <% end %>
</div>

<!-- 6 Anahtar Metrik Kartı -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 2rem;">
  <div class="stat-card" style="border-top: 3px solid var(--neutral-dark);">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">🎫</div>
    <div class="stat-value"><%= @total_tickets %></div>
    <div class="stat-label">Toplam Destek Talebi</div>
  </div>

  <div class="stat-card" style="border-top: 3px solid var(--success);">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">✅</div>
    <div class="stat-value" style="color: var(--success);"><%= @solved_tickets %></div>
    <div class="stat-label">Çözülen / Kapatılan</div>
  </div>

  <div class="stat-card" style="border-top: 3px solid <%= @compliance_rate >= 80 ? 'var(--success)' : 'var(--danger)' %>;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">⏱️</div>
    <div class="stat-value" style="color: <%= @compliance_rate >= 80 ? 'var(--success)' : 'var(--danger)' %>;">
      %<%= @compliance_rate %>
    </div>
    <div class="stat-label">SLA Karşılama Oranı</div>
    <div style="background: #e2e8f0; height: 6px; border-radius: 3px; margin-top: 8px; overflow: hidden;">
      <div style="background: <%= @compliance_rate >= 80 ? '#10b981' : '#ef4444' %>; width: <%= [@compliance_rate, 100].min %>%; height: 100%; border-radius: 3px;"></div>
    </div>
  </div>

  <div class="stat-card" style="border-top: 3px solid var(--primary);">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">⚡</div>
    <div class="stat-value" style="color: var(--primary);">
      <%= @avg_first_response_minutes ? "#{@avg_first_response_minutes} dk" : "Ölçüm Yok" %>
    </div>
    <div class="stat-label">
      Ortalama İlk Yanıt Süresi
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        (Yalnızca yanıtlanmış <%= @responded_count %> talep)
      </div>
    </div>
  </div>

  <div class="stat-card" style="border-top: 3px solid #6366f1;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">🎯</div>
    <div class="stat-value" style="color: #6366f1;">
      <%= @avg_resolution_hours ? "#{@avg_resolution_hours} saat" : "Ölçüm Yok" %>
    </div>
    <div class="stat-label">
      Ortalama Çözüm Süresi
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        (Yalnızca çözülen <%= @solved_count %> talep)
      </div>
    </div>
  </div>

  <div class="stat-card" style="border-top: 3px solid #06b6d4;">
    <div style="font-size: 1.25rem; margin-bottom: 0.25rem;">💬</div>
    <div class="stat-value" style="color: #06b6d4;">
      %<%= @conversion_rate %>
    </div>
    <div class="stat-label">
      Forum 24h Dönüşüm Oranı
      <div style="font-size: 0.725rem; color: var(--neutral-muted); font-weight: 500; margin-top: 2px;">
        (<%= @converted_questions %> / <%= @total_forum_questions %> soru bilete dönüştü)
      </div>
    </div>
    <div style="background: #e2e8f0; height: 6px; border-radius: 3px; margin-top: 8px; overflow: hidden;">
      <div style="background: #06b6d4; width: <%= [@conversion_rate, 100].min %>%; height: 100%; border-radius: 3px;"></div>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
  <!-- Çalışan Başına İş Yükü -->
  <div class="card">
    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--neutral-dark);">
      👨‍💼 Destek Çalışanları ve İş Yükü Dağılımı
    </h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Çalışan Adı</th>
          <th>Departman</th>
          <th>Aktif Atanmış Talep</th>
          <th>Çözülen Talep</th>
        </tr>
      </thead>
      <tbody>
        <% @agents.each do |agent| %>
          <tr>
            <td><strong><%= agent[:name] %></strong></td>
            <td><%= agent[:department] %></td>
            <td>
              <span class="table-badge badge-warning"><%= agent[:assigned_count] %> aktif</span>
            </td>
            <td>
              <span class="table-badge badge-success"><%= agent[:solved_count] %> çözüldü</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Kategori Dağılımı -->
  <div class="card">
    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--neutral-dark);">
      📂 Kategori Dağılımı
    </h3>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <% @category_stats.each do |cat, count| %>
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem;">
            <span><%= cat || "Diğer" %></span>
            <span><%= count %> talep</span>
          </div>
          <div style="background: #f1f5f9; height: 8px; border-radius: 4px; overflow: hidden;">
            <% pct = @total_tickets.positive? ? (count.to_f / @total_tickets * 100).round : 0 %>
            <div style="background: var(--primary); width: <%= pct %>%; height: 100%;"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
