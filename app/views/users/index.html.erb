<% content_for :title, "Kullanıcı Yönetimi — Admin" %>

<div class="page-header">
  <div>
    <h1 class="page-title">⚙️ Kullanıcı Yönetimi</h1>
    <p class="page-subtitle">Sisteme kayıtlı tüm kullanıcıları görüntüleyin ve rollerini yönetin.</p>
  </div>
  <div style="font-size: 0.85rem; color: var(--neutral-muted); align-self: center; background: white; padding: 0.4rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border);">
    <strong><%= @users.count %></strong> kullanıcı kayıtlı
  </div>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Kullanıcı</th>
          <th>E-posta</th>
          <th>Mevcut Rol</th>
          <th>Departman</th>
          <th>Bildirim</th>
          <th>Kayıt Tarihi</th>
          <th style="text-align: right;">Rol Değiştir</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: <%= user.admin? ? '#fef3c7' : user.agent? ? '#e0e7ff' : '#f0fdf4' %>; color: <%= user.admin? ? '#92400e' : user.agent? ? '#4338ca' : '#166534' %>; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; flex-shrink: 0; border: 1px solid <%= user.admin? ? '#fde68a' : user.agent? ? '#c7d2fe' : '#bbf7d0' %>;">
                  <%= user.name.first.upcase %>
                </div>
                <div>
                  <div style="font-weight: 700; font-size: 0.9rem; color: var(--neutral-dark);"><%= user.name %></div>
                  <% if user.id == current_user.id %>
                    <span style="font-size: 0.725rem; font-weight: 700; color: var(--primary);">(aktif oturum)</span>
                  <% end %>
                </div>
              </div>
            </td>
            <td style="font-size: 0.85rem; color: var(--neutral-muted);"><%= user.email %></td>
            <td>
              <% role_cfg = { "admin" => ["⚡ Yönetici", "badge-danger"], "agent" => ["👨‍💼 Temsilci", "badge-info"], "customer" => ["👤 Müşteri", "badge-success"] } %>
              <span class="table-badge <%= role_cfg[user.role]&.last %>">
                <%= role_cfg[user.role]&.first || user.role.upcase %>
              </span>
            </td>
            <td style="font-size: 0.85rem; font-weight: 600;"><%= user.department || "—" %></td>
            <td>
              <span style="font-size: 0.825rem;">
                <%= user.email_notifications_enabled? ? "✅ Açık" : "🔕 Kapalı" %>
              </span>
            </td>
            <td style="font-size: 0.8rem; color: var(--neutral-muted);">
              <%= user.created_at.strftime("%d.%m.%Y") %>
            </td>
            <td style="text-align: right;">
              <% if user.id != current_user.id %>
                <%= form_with url: admin_update_user_role_path(user), method: :patch, local: true, style: "display: inline-flex; gap: 0.4rem; align-items: center; justify-content: flex-end;" do %>
                  <select name="role" class="form-select" style="font-size: 0.8rem; padding: 0.35rem 0.55rem; min-width: 125px; border-radius: var(--radius-sm);">
                    <% User::ROLES.each do |role| %>
                      <option value="<%= role %>" <%= 'selected' if user.role == role %>>
                        <%= { "admin" => "⚡ Yönetici", "agent" => "👨‍💼 Temsilci", "customer" => "👤 Müşteri" }[role] %>
                      </option>
                    <% end %>
                  </select>
                  <button type="submit" class="btn btn-secondary btn-sm" style="font-size: 0.775rem; padding: 0.35rem 0.65rem;">
                    Kaydet
                  </button>
                <% end %>
              <% else %>
                <span style="font-size: 0.8rem; color: var(--neutral-muted); font-style: italic;">Kendi rolünüzü değiştiremezsiniz</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
