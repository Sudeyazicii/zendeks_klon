<% content_for :title, "Kullanıcı Profili & Bildirim Tercihleri" %>

<div style="max-width: 680px; margin: 0 auto;">
  <div class="page-header" style="margin-bottom: 1.5rem;">
    <div>
      <h1 class="page-title">Profil & Bildirim Ayarları</h1>
      <p class="page-subtitle">Kullanıcı bilgilerinizi, departmanınızı ve bildirim tercihlerinizi yönetin.</p>
    </div>
  </div>

  <div class="card" style="padding: 2.25rem;">
    <div style="display: flex; align-items: center; gap: 1.15rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
      <div style="width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%); color: #4338ca; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; border: 2px solid #a5b4fc; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);">
        <%= @user.name.first.upcase %>
      </div>
      <div>
        <div style="font-size: 1.25rem; font-weight: 800; color: var(--neutral-dark);"><%= @user.name %></div>
        <div style="font-size: 0.85rem; color: var(--neutral-muted); margin-top: 0.2rem;">
          <%= @user.email %> • Rol: <strong style="color: var(--primary);"><%= @user.role.upcase %></strong>
        </div>
      </div>
    </div>

    <%= form_with model: @user, url: update_preferences_path, method: :patch, local: true do |f| %>
      <div class="form-group" style="margin-bottom: 1.25rem;">
        <%= f.label :name, "Ad Soyad", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <%= f.label :department, "Ekip / Departman", class: "form-label" %>
        <%= f.select :department, [
          ["👥 Destek Ekibi", "Destek Ekibi"],
          ["🧾 Fatura & Muhasebe", "Fatura & Muhasebe"],
          ["💻 Teknik & Altyapı", "Teknik & Altyapı"],
          ["⚡ Yönetim", "Yönetim"]
        ], {}, class: "form-select" %>
      </div>

      <!-- Bildirim Tercihleri (Spam Önleme Çözümü) -->
      <div style="margin-top: 1.5rem; padding: 1.25rem; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
        <strong style="color: var(--neutral-dark); font-size: 0.95rem; display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.35rem;">
          <span>🔔</span> Bildirim Kanalları & Tercihler
        </strong>
        <p style="font-size: 0.825rem; color: var(--neutral-muted); margin-bottom: 0.85rem; line-height: 1.45;">
          E-posta bildirim karmaşasına karşı, bildirim tercihlerinizi buradan dilediğiniz gibi açıp kapatabilirsiniz:
        </p>

        <label style="display: flex; align-items: center; gap: 0.65rem; cursor: pointer; font-size: 0.9rem; font-weight: 600; color: var(--neutral-dark); background: white; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border);">
          <%= f.check_box :email_notifications_enabled, style: "width: 18px; height: 18px; accent-color: var(--primary);" %>
          <span>Yeni bilet atamalarında ve müşteri yanıtlarında e-posta bildirimleri gönderilsin</span>
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border);">
        <%= f.submit "Tercihleri Kaydet", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
